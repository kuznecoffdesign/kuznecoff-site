---
import {demoCases} from '../../../data/demoCases.js';
export function getStaticPaths(){return [{business:'window-service',channel:undefined},{business:'window-service',channel:'maps'},{business:'vysota',channel:'maps'},{business:'vysota',channel:'vk'}].map(params=>({params,props:{data:demoCases[params.business]}}))}
const {data}=Astro.props;const {business,channel}=Astro.params;const base=import.meta.env.BASE_URL.replace(/\/$/,'');const img=`${base}/images/cases/${business}/cover.webp`;const asset=(file)=>`${base}/images/cases/${business}/${file}`;const slides=business==='vysota'?['cover.webp','bedroom.webp','kitchen.webp','bedroom.webp','cover.webp']:['technician.webp','cover.webp'];const back=`${base}/work/${business}/`;const vk=channel==='vk';const maps=channel==='maps';
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{data.name} — {vk?'ВКонтакте':maps?'Карты':'Ремонт окон'}</title></head><body class:list={[business,{'platform':!!channel,'vk':vk,'maps':maps}]}><a class="return" href={back}>← К кейсу</a>
{!channel?<><header><strong>{data.name}</strong><nav><a href="#services">Услуги</a><a href="#faq">Вопросы</a><a href="#contact">Связаться</a></nav></header><main><section class="hero"><div><p class="eyebrow">{data.tag}</p><h1>{data.intro}</h1><p>{data.description}</p><a class="action" href="#services">Найти свою проблему</a></div><img src={asset('technician.webp')} alt="Мастер регулирует оконную фурнитуру"/></section><section id="services"><h2>Что беспокоит ваше окно?</h2><div class="services">{data.services.map(([name,desc,price])=><article><h3>{name}</h3><p>{desc}</p><strong>{price}</strong></article>)}</div></section><section class="steps"><h2>Сначала диагностика, затем решение</h2><div><article><b>01</b><h3>Опишите симптом</h3><p>Расскажите, что происходит, и приложите фото.</p></article><article><b>02</b><h3>Проверим окно</h3><p>Определим причину и согласуем смету.</p></article><article><b>03</b><h3>Устраним проблему</h3><p>Подберём подходящий ремонт и проверим работу створок.</p></article></div></section><section id="faq"><h2>Частые вопросы</h2>{data.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section id="contact"><h2>Расскажите, что случилось с окном</h2><p>Подскажем, с чего начать. Демонстрационный проект — контакты не подключены.</p><button disabled>Написать в мессенджер</button></section></main></>:<><div class="platform-top"><b>{vk?'ВКонтакте':'Яндекс Карты'}</b><span>Демонстрация оформления</span></div><main class="platform-layout">{vk&&<aside class="vk-sidebar"><p>Моя страница</p><p>Новости</p><p>Мессенджер</p><p>Сообщества</p><p>Фото</p><p>Видео</p></aside>}<div class="platform-main"><section class="profile"><div class="cover" style={`background-image:linear-gradient(90deg,#0008,transparent),url('${img}')`}><div><span>{data.tag}</span><h1>{data.name}</h1><p>{data.intro}</p></div></div><div class="profile-info"><div class="avatar">{data.name.slice(0,1)}</div><div><h2>{data.name} · {data.tag}</h2><p>{data.description}</p></div></div><div class="actions"><button disabled>{vk?'Написать':'Позвонить'}</button><button disabled>{vk?'Подписаться':'Маршрут'}</button></div><nav class="tabs"><a href="#catalog">Услуги</a>{vk&&<a href="#wall">Записи</a>}<a href="#info">Информация</a></nav></section><section class="platform-card" id="catalog"><h2>{vk?'Товары и услуги':'Услуги и цены'}</h2><div class="catalog">{data.services.map(([name,desc,price],i)=><article><img src={asset(slides[i%slides.length])} alt="Визуализация услуги" style={`object-position:${25+i*20}% center`}/><h3>{name}</h3><p>{desc}</p><b>{price}</b></article>)}</div></section>{vk&&<section id="wall"><article class="platform-card"><small>Закреплённая запись</small><h2>Планируете ремонт?</h2><p>Начните с вопросов о будущем потолке. Расскажите о комнате, желаемом освещении и бюджете — подберём варианты для обсуждения на замере.</p></article>{data.posts.map(([title,body],i)=><article class="platform-card post"><div class="post-author"><span class="mini-avatar">В</span><b>Высота · Натяжные потолки</b></div><h2>{title}</h2><p>{body}</p><div class="post-visual" style={`background-image:linear-gradient(0deg,#223228d9,transparent 85%),url('${asset(slides[i%slides.length])}');background-position:center`}><strong>{title}</strong><span>ВЫСОТА / ПОЛЕЗНО ЗНАТЬ</span></div><small>Нравится · Комментировать · Поделиться</small></article>)}</section>}<section class="platform-card" id="info"><h2>О компании</h2><p>{data.description}</p><p class="note">Демонстрационный макет. Цены ориентировочные, не действующий бизнес.</p></section></div>{vk&&<aside class="vk-right"><div class="platform-card"><b>Информация</b><p>{data.tag}</p><p>Услуги · Публикации · Сообщения</p></div></aside>}</main></>}
<style> *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:#14344f;background:#f4f9ff;font:16px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}h1,h2,h3,p{margin:0 0 14px}h1{font-size:clamp(38px,6vw,78px);line-height:1.03;letter-spacing:-.055em}h2{font-size:clamp(26px,3.5vw,45px);line-height:1.15;letter-spacing:-.03em}h3{font-size:22px;line-height:1.25}.return{position:fixed;bottom:18px;left:18px;z-index:10;padding:11px 20px;background:#182326;color:white;border-radius:25px;font-size:14px}header{padding:20px max(5vw,24px);display:flex;justify-content:space-between;align-items:center;background:white;gap:20px}header strong{font-size:24px}header nav{display:flex;gap:20px;flex-wrap:wrap}main>section{padding:clamp(35px,6vw,90px) max(5vw,24px)}.hero{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.hero img{width:100%;height:440px;object-fit:cover;border-radius:18px}.hero p{max-width:550px}.eyebrow{color:#2768a1;font-weight:bold}.action,button{display:inline-block;background:#175b92;color:white;border:0;border-radius:9px;padding:13px 22px;font:inherit;font-weight:bold}.action{margin-top:15px}.services,.steps>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.services article,.steps article{background:white;padding:28px;border-radius:16px;border:1px solid #d5e4f3}.steps{background:#e4f0fc}.steps>div{grid-template-columns:repeat(3,1fr)}.steps b{color:#2768a1}details{padding:18px 0;border-bottom:1px solid #b7cbdc}summary{cursor:pointer;font-weight:bold}details p{margin:12px 0 0}#contact{background:#123d60;color:white}button:disabled{cursor:default;opacity:.85}.platform{background:#edeef0;color:#222;font:15px/1.45 Arial,sans-serif}.platform-top{background:#fff;padding:14px max(5vw,20px);border-bottom:1px solid #ddd;display:flex;gap:28px;align-items:center}.platform-top b{font-size:20px;color:#1676c9}.platform-top span{color:#777;font-size:13px}.platform-layout{display:grid;grid-template-columns:minmax(0,170px) minmax(0,760px) minmax(0,250px);gap:16px;max-width:1220px;margin:18px auto;padding:0 18px}.maps .platform-layout{display:block;max-width:850px}.platform-main{min-width:0}.vk-sidebar{color:#45658a;padding:12px 0}.profile,.platform-card{background:white;border:1px solid #dddfe3;border-radius:12px;overflow:hidden;margin-bottom:14px}.profile .cover{height:240px;background-size:cover;background-position:center;display:flex;align-items:center;color:white;padding:25px}.profile .cover h1{font-size:clamp(35px,6vw,68px);font-family:Georgia,serif;margin:5px 0}.profile .cover span{font-size:13px;text-transform:uppercase;letter-spacing:.1em}.profile-info{display:flex;gap:15px;padding:20px;align-items:center}.profile-info h2{font-size:20px}.avatar,.mini-avatar{display:grid;place-items:center;background:#3f5144;color:white;border-radius:50%;flex-shrink:0}.avatar{width:64px;height:64px;font:38px Georgia,serif}.mini-avatar{width:34px;height:34px}.actions,.tabs{padding:0 20px 15px;display:flex;gap:12px;flex-wrap:wrap}.actions button{background:#0077ff;font-size:14px}.actions button+button{background:#e8edf3;color:#2766a0}.tabs{border-top:1px solid #e4e4e4;padding-top:14px;font-weight:bold}.platform-card{padding:20px}.platform-card h2{font-size:21px;letter-spacing:0}.catalog{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.catalog img{width:100%;height:135px;object-fit:cover;border-radius:8px}.catalog h3{font-size:16px;margin:8px 0}.catalog p{font-size:14px;color:#5e5e5e}.post-author{display:flex;align-items:center;gap:9px;margin-bottom:16px}.post-visual{aspect-ratio:1.35;background-size:cover;display:flex;flex-direction:column;justify-content:end;padding:25px;color:#fff;border-radius:8px;margin:20px 0 12px}.post-visual strong{font:clamp(24px,4vw,42px)/1.1 Georgia,serif;max-width:90%;margin-bottom:12px}.post-visual span{font-size:12px;letter-spacing:.12em}.note,small{color:#6b7179}.vysota .avatar{background:#515a40}.vysota .cover{font-family:Georgia,serif}.window-service .avatar{background:#175b92}@media(max-width:940px){.platform-layout{grid-template-columns:140px minmax(0,1fr)}.vk-right{display:none}}@media(max-width:650px){header nav{display:none}.hero{grid-template-columns:1fr;gap:20px}.hero img{height:260px}.services,.steps>div{grid-template-columns:1fr}.platform-layout{display:block;padding:0 8px}.vk-sidebar{display:none}.profile .cover{height:185px}.profile-info{align-items:flex-start}.catalog{gap:10px}.catalog img{height:100px}.post-visual{padding:16px}.platform-card{padding:15px}.return{bottom:9px;left:9px}}</style></body></html>
