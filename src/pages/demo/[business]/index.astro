---
import '../../../styles/business-polish.css';
import WindowWebsite from '../../../components/WindowWebsite.astro';
import CeilingWebsite from '../../../components/CeilingWebsite.astro';
import {demoCases} from '../../../data/demoCases.js';
export function getStaticPaths(){return Object.keys(demoCases).map(business=>({params:{business},props:{data:demoCases[business]}}))}
const {data}=Astro.props;const {business}=Astro.params;const base=import.meta.env.BASE_URL.replace(/\/$/,'');const asset=(file)=>`${base}/images/cases/${business}/${file}`;const back=`${base}/work/${business}/`;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{data.name} — {data.tag}</title></head><body><a class="return" href={back}>← К кейсу</a>{business==='vysota'?<CeilingWebsite data={data} asset={asset}/>:<WindowWebsite data={data} asset={asset}/>}</body></html>
<style is:global>*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}button,input,select{font:inherit}details summary{cursor:pointer}button:disabled{opacity:.8}.return{position:fixed;bottom:18px;left:18px;z-index:10;padding:11px 20px;background:#182326;color:white;border-radius:25px;font:14px Arial,sans-serif}nav{display:flex;gap:22px}button{cursor:pointer}button:disabled{cursor:default}</style>
