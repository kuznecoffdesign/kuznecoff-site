---
import {services,money,about} from '../../../data/detailWorks.js';
import '../../../styles/detail-demo.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const img=file=>`${base}/images/cases/detail/${file}`;
const demo=`${base}/demo/detail-works/`;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Detail Works — карточка на картах</title></head><body class="dw-mock-page"><a class="case-return" href="../../../work/detail/">← К кейсу</a>
<div class="dw-demo-bar"><span>Яндекс Карты · Карточка</span><a href={`${base}/work/detail/`}>К кейсу Kuznecoff</a></div><header class="dw-platform-head"><strong><span>К</span> Деловая карточка</strong><a href={demo}>Сайт Detail Works</a></header>
<main class="dw-platform-container"><div class="dw-maps-layout"><div class="dw-ui-card"><img class="dw-platform-cover" src={img('dw4-vk-cover.webp')} alt="Обложка Detail Works"/><div class="dw-platform-bio"><img src={img('dw2-vk-avatar.webp')} alt="Логотип Detail Works"/><div><h1>Detail Works</h1><p>Детейлинг и уход за автомобилем</p></div><a class="dw-ui-button" href={`${demo}#estimate`}>Рассчитать стоимость</a></div><div class="dw-ui-tabs" role="tablist">{[['overview','Обзор'],['services','Услуги'],['offers','Акции'],['photos','Фото']].map(([id,label],i)=><button type="button" role="tab" aria-selected={i===0} data-panel={id}>{label}</button>)}</div><div class="dw-ui-body dw-ui-panel" data-content="overview"><h2>О компании</h2><p>{about}</p><div class="dw-maps-stories">{[...services.map(s=>s.story),'dw2-maps-check.webp'].map((file,i)=><a href={img(file)} target="_blank" rel="noopener"><img src={img(file)} alt={i===4?'Осмотр перед работой':services[i].name}/></a>)}</div><h2>Популярные услуги</h2><div class="dw-ui-services">{services.slice(0,3).map(s=><article class="dw-ui-service"><img src={img(s.image)} alt={s.name}/><div><h3>{s.name}</h3><p>{s.short}</p><b>от {money(s.price)}</b></div></article>)}</div></div><div class="dw-ui-body dw-ui-panel" data-content="services" hidden><h2>Каталог услуг</h2><div class="dw-ui-services">{services.map(s=><article class="dw-ui-service"><img src={img(s.image)} alt={s.name}/><div><h3>{s.name}</h3><p>{s.description}</p><b>от {money(s.price)} · {s.time}</b></div></article>)}</div><p style="margin-top:14px;font-size:12px">Стоимость зависит от объёма работ.</p></div><div class="dw-ui-body dw-ui-panel" data-content="offers" hidden><h2>Акции и предложения</h2><div class="dw-ui-services"><article class="dw-ui-service"><img src={img('dw2-maps-check.webp')} alt="Осмотр перед работой"/><div><h3>Осмотр и подбор комплекса</h3><p>Сначала определяем состояние автомобиля и состав работ. Затем предлагаем подходящий комплекс.</p></div></article><article class="dw-ui-service"><img src={img('dw2-photo-protect.webp')} alt="Керамическая защита"/><div><h3>Комплекс защиты кузова</h3><p>Полировка и нанесение защитного состава в одной последовательности. Объём после осмотра.</p></div></article></div></div><div class="dw-ui-body dw-ui-panel" data-content="photos" hidden><h2>Фотоматериалы</h2><div class="dw-ui-photo-grid">{['hero-real-studio.webp',...services.map(s=>s.image)].map(file=><a href={img(file)} target="_blank" rel="noopener"><img src={img(file)} alt="Фотография детейлинга"/></a>)}</div></div></div><aside><div class="dw-map-preview" aria-label="Схематичная карта без реального местоположения"><div class="dw-map-pin"><b>Detail Works</b>Местоположение не задано<br/><small>Схема карты</small></div></div><div class="dw-ui-card dw-ui-body" style="margin-top:20px"><h2>Карточка подготовлена</h2><p>Описание, каталог услуг, акционные предложения, обложки, истории и фотоматериалы собраны в единой системе.</p><img src={img('dw2-maps-cover.webp')} alt="Основной баннер карточки" style="display:block;width:100%;margin-top:18px;border-radius:12px"/></div></aside></div></main>
<script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-panel]');const panels=document.querySelectorAll<HTMLElement>('[data-content]');buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.setAttribute('aria-selected',String(b===button)));panels.forEach(p=>p.hidden=p.dataset.content!==button.dataset.panel)}));</script></body></html>
