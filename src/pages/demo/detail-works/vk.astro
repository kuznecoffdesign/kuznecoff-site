---
import {services,money,about,posts} from '../../../data/detailWorks.js';
import '../../../styles/detail-demo.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const img=file=>`${base}/images/cases/detail/${file}`;
const demo=`${base}/demo/detail-works/`;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Detail Works — макет сообщества ВКонтакте</title></head><body class="dw-mock-page">
<div class="dw-demo-bar"><span>Авторский проект · Макет сообщества ВКонтакте</span><a href={`${base}/work/detail/`}>К кейсу Kuznecoff</a></div><header class="dw-platform-head"><strong><span style="background:#3268dc">ВК</span> Макет сообщества</strong><a href={demo}>Сайт Detail Works</a></header>
<main class="dw-platform-container"><div class="dw-platform-notice">Демонстрационный макет сообщества. Реального сообщества, подписчиков и заявок нет. Все посты, обложки и описания подготовлены в рамках авторского проекта.</div><section class="dw-ui-card"><img class="dw-platform-cover" src={img('vk-cover.webp')} alt="Обложка сообщества Detail Works"/><div class="dw-platform-bio"><img src={img('vk-avatar.webp')} alt="Аватар Detail Works"/><div><h1>Detail Works</h1><p>Детейлинг • Защита кузова • Химчистка</p></div><a class="dw-ui-button" href={`${demo}#estimate`}>Рассчитать стоимость</a></div><div class="dw-ui-tabs"><a href="#about">О сообществе</a><a href="#services">Услуги</a><a href="#posts">Публикации</a><a href={demo}>Сайт</a></div><div class="dw-ui-body" id="about"><h2>О нас</h2><p>{about}</p><div class="dw-vk-menu"><a href="#services">Каталог услуг</a><a href={`${demo}#prices`}>Стоимость</a><a href={`${demo}#process`}>Как работаем</a></div></div></section><div class="dw-vk-layout"><section class="dw-vk-feed" id="posts">{posts.map((post)=><article class="dw-ui-card dw-vk-post"><div class="dw-vk-post-header"><img src={img('vk-avatar.webp')} alt=""/><div><b>Detail Works</b><small>Демонстрационная публикация</small></div></div><p><strong>{post.title}</strong><br/>{post.text}</p><img src={img(post.image)} alt={`Дизайн публикации: ${post.title}`} loading="lazy"/></article>)}</section><aside class="dw-vk-sidebar" id="services"><div class="dw-ui-card"><h2>Услуги</h2><div class="dw-ui-services">{services.map(s=><a href={`${demo}#estimate`} class="dw-ui-service"><img src={img(s.image)} alt=""/><div><h3>{s.name}</h3><b>от {money(s.price)}</b></div></a>)}</div><p style="margin-top:15px;font-size:12px">Демонстрационные стартовые цены.</p></div><div class="dw-ui-card"><h2>Оформление</h2><p>Обложка, аватар, описание, навигация по услугам и пять публикаций. Единая палитра, графический знак и последовательная подача контента.</p></div></aside></div></main></body></html>
