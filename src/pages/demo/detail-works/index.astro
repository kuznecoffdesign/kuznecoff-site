---
import {services,money} from '../../../data/detailWorks.js';
import '../../../styles/detail-demo.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const img=file=>`${base}/images/cases/detail/${file}`;
---
<!doctype html>
<html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Авторский демонстрационный сайт студии детейлинга Detail Works"/><title>Detail Works — студия детейлинга</title></head>
<body class="dw-site">
<div class="dw-demo-bar"><span>Авторский проект · Демонстрационный сайт</span><a href={`${base}/work/detail/`}>К кейсу Kuznecoff</a></div>
<header class="dw-header"><a href="#top" class="dw-brand"><b><i>D</i>W</b><span>DETAIL<br/>WORKS</span></a><nav aria-label="Навигация"><a href="#services">Услуги</a><a href="#prices">Стоимость</a><a href="#process">Как работаем</a><a href="#faq">Вопросы</a></nav><a href="#estimate" class="dw-button dw-small">Рассчитать стоимость</a></header>
<main id="top">
<section class="dw-hero" style={`--hero:url('${img('cover.webp')}')`}><div class="dw-hero-inner"><p class="dw-eyebrow">ДЕТЕЙЛИНГ / ЗАЩИТА / УХОД</p><h1>Чистота<br/>в деталях<span>.</span></h1><p>Профессиональный уход за автомобилем. Восстановление блеска, защита кузова и аккуратный салон — с вниманием к каждой поверхности.</p><div class="dw-hero-actions"><a class="dw-button" href="#estimate">Подобрать комплекс</a><a class="dw-ghost" href="#services">Смотреть услуги</a></div></div><div class="dw-hero-bottom"><span>01 / DETAIL WORKS</span><span>Графит. Свет. Точность.</span></div></section>
<section class="dw-section" id="services"><div class="dw-section-heading"><div><p class="dw-eyebrow">01 / УСЛУГИ</p><h2>Уход<br/>по делу<span>.</span></h2></div><p>Четыре направления, которые можно подобрать под состояние и задачи вашего автомобиля.</p></div><div class="dw-service-grid">{services.map((s,i)=><article class="dw-service"><div class="dw-service-image" style={`background-image:url('${img(s.image)}')`}><span>0{i+1}</span></div><div class="dw-service-info"><h3>{s.name}</h3><p>{s.short}</p><div class="dw-service-bottom"><b>от {money(s.price)}</b><a href="#estimate" class="dw-ghost" data-select={s.id}>Выбрать</a></div></div></article>)}</div></section>
<section class="dw-section dw-light" id="prices"><div class="dw-section-heading"><div><p class="dw-eyebrow">02 / СТОИМОСТЬ</p><h2>Понятная<br/>цена<span>.</span></h2></div><p>Сначала осматриваем автомобиль, затем согласуем объём работ. Здесь приведены демонстрационные стартовые цены.</p></div><div class="dw-price-list">{services.map(s=><div><h3>{s.name}</h3><span>{s.time}</span><b>от {money(s.price)}</b></div>)}</div><p class="dw-note">Цены приведены для демонстрации структуры сайта, не являются предложением действующей студии.</p></section>
<section class="dw-section" id="process"><div class="dw-section-heading"><div><p class="dw-eyebrow">03 / ПРОЦЕСС</p><h2>Каждый<br/>этап важен<span>.</span></h2></div><p>Понятная последовательность от первого обращения до передачи автомобиля.</p></div><div class="dw-process-grid">{[['Осмотр','Изучаем состояние покрытия и салона, уточняем нужный результат.'],['Согласование','Подбираем работы, согласуем стоимость и сроки.'],['Детейлинг','Выполняем согласованный комплекс с учётом материалов автомобиля.'],['Передача','Показываем результат и объясняем дальнейший уход.']].map(([h,d],i)=><article><span>0{i+1}</span><h3>{h}</h3><p>{d}</p></article>)}</div></section>
<section class="dw-section dw-estimate" id="estimate"><div class="dw-section-heading"><div><p class="dw-eyebrow">04 / КОНСУЛЬТАЦИЯ</p><h2>Подберём<br/>комплекс<span>.</span></h2></div><p>Выберите услуги и тип автомобиля. Калькулятор покажет ориентир для демонстрационного проекта.</p></div><div class="dw-estimate-panel"><form id="dw-estimate-form"><fieldset><legend>Что вас интересует?</legend>{services.map(s=><label class="dw-option"><input type="checkbox" name="service" value={s.id} data-price={s.price}/><span>{s.name}</span><b>от {money(s.price)}</b></label>)}</fieldset><label class="dw-field">Тип автомобиля<select id="dw-car"><option value="1">Седан / хетчбэк</option><option value="1.15">Кроссовер</option><option value="1.25">Внедорожник</option></select></label><button type="submit" class="dw-button">Рассчитать ориентир</button></form><div class="dw-estimate-summary"><span>ПРЕДВАРИТЕЛЬНЫЙ РАСЧЁТ</span><strong id="dw-total">—</strong><p id="dw-summary">Выберите одну или несколько услуг.</p><small>Демонстрационный калькулятор. Заявка не отправляется, персональные данные не собираются.</small></div></div></section>
<section class="dw-section dw-light" id="faq"><div class="dw-section-heading"><div><p class="dw-eyebrow">05 / ВОПРОСЫ</p><h2>Что нужно<br/>знать<span>.</span></h2></div></div><div class="dw-faq">{[['Как понять, нужна ли полировка?','После осмотра покрытия можно определить, достаточно ли лёгкой коррекции или нужен более глубокий комплекс.'],['Можно ли сразу сделать керамику?','Защитный состав наносится на подготовленную поверхность; объём подготовки зависит от состояния ЛКП.'],['Сколько займёт работа?','Время зависит от размера автомобиля, его состояния и выбранных услуг. Точный срок согласовывается после осмотра.'],['Как ухаживать за автомобилем после работ?','Рекомендации по уходу зависят от применённых материалов и выполненного комплекса.']].map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></section>
</main><footer class="dw-footer"><a href="#top" class="dw-brand"><b><i>D</i>W</b><span>DETAIL<br/>WORKS</span></a><p>Самостоятельный демонстрационный проект Kuznecoff. Реального адреса, записи и услуг студии нет.</p><a href={`${base}/work/detail/`}>Вернуться к кейсу</a></footer>
<script>
const form=document.querySelector('#dw-estimate-form') as HTMLFormElement; const total=document.querySelector('#dw-total') as HTMLElement; const summary=document.querySelector('#dw-summary') as HTMLElement; const format=(v:number)=>new Intl.NumberFormat('ru-RU').format(v)+' ₽';
function calculate(){const chosen=[...form.querySelectorAll<HTMLInputElement>('input[name=service]:checked')];const multiplier=Number((document.querySelector('#dw-car') as HTMLSelectElement).value);const sum=chosen.reduce((s,x)=>s+Number(x.dataset.price),0);total.textContent=sum?'от '+format(Math.ceil(sum*multiplier/100)*100):'—';summary.textContent=chosen.length?`Выбрано услуг: ${chosen.length}. Точная стоимость зависит от осмотра.`:'Выберите одну или несколько услуг.';}
form.addEventListener('change',calculate);form.addEventListener('submit',e=>{e.preventDefault();calculate();});document.querySelectorAll<HTMLElement>('[data-select]').forEach(el=>el.addEventListener('click',()=>{const input=form.querySelector<HTMLInputElement>(`[value="${el.dataset.select}"]`);if(input)input.checked=true;calculate()}));
</script></body></html>
