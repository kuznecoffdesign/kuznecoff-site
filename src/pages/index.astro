---
import Base from '../layouts/Base.astro';
import ProjectCover from '../components/ProjectCover.astro';
import {projects,categories} from '../data/projects.js';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const faq=[["Сколько времени занимает работа?","От 7 дней для небольшого проекта. Срок зависит от объёма, готовности материалов и скорости согласований. Точный график предложу после обсуждения."],["Что нужно от меня для начала?","Расскажите о бизнесе, целях и текущих площадках. Если есть фотографии, фирменный стиль или прайс, пришлите их. Список недостающих материалов определим вместе."],["Можно ли заказать только одну услугу?","Да. Можно отдельно оформить карты, сообщество ВКонтакте, сайт или заказать сопровождение."],["Как формируется стоимость?","На сайте указаны стартовые цены. После знакомства с бизнесом подготовлю персональное предложение с составом работ, этапами, сроками и итоговой стоимостью."],["Сколько правок входит в работу?","До двух раундов правок в согласованном объёме. Дополнительные изменения предварительно обсудим."],["Помогаешь ли ты с размещением материалов?","Да, помогаю разместить согласованные материалы на площадках и передаю исходники в рамках проекта."],["Можно ли заказать дальнейшее сопровождение?","Да. Обновляю информацию, товары, акции и визуальные материалы. Объём и периодичность согласуем отдельно."],["Как происходит оплата?","Условия и график оплаты зафиксируем в персональном предложении до начала работы."]];
const packages=[
  {name:'Карты',price:'12 900 ₽',description:'Чтобы вас было проще найти и выбрать рядом',features:['Анализ, описание, услуги, визуалы для Яндекс Карт и 2ГИС','—','—','—']},
  {name:'Карты + ВК',price:'29 900 ₽',description:'Чтобы клиент нашёл вас и получил ответы на вопросы',features:['Анализ, каталог и визуалы','Обложка, меню, услуги и стартовые публикации','—','—']},
  {name:'Комплекс',price:'69 900 ₽',description:'Чтобы площадки работали вместе на обращение клиента',features:['Анализ, каталог и визуалы','Обложка, меню, услуги и стартовые публикации','Адаптивный сайт: услуги, аргументы, контакты','По задаче бизнеса']}
];
const features=['Карты','ВКонтакте','Сайт','Доп. площадка'];
const extras=[['Сайт-визитка','Страница с главной информацией о бизнесе и переходом в мессенджер','от 29 900 ₽'],['Индивидуальный лендинг','Отдельный дизайн и структура под задачу бизнеса','от 45 000 ₽'],['Многостраничный сайт','Структура страниц и базовая SEO-подготовка','от 80 000 ₽'],['Сопровождение','Обновление информации и материалов на площадках','от 9 900 ₽/мес']];
const steps=[{title:'Знакомство и аудит',description:'Обсуждаем ваш бизнес. Изучаю действующие площадки, услуги и то, как клиенты вас находят.',result:'Понятная задача и согласованный объём работ'},{title:'Структура и идея',description:'Определяю, какую информацию нужно показать, как её организовать и каким должен быть визуальный стиль.',result:'Структура и согласованное визуальное направление'},{title:'Дизайн и согласование',description:'Оформляю материалы, показываю промежуточный результат и вношу согласованные правки.',result:'Готовые визуалы и макеты'},{title:'Запуск и передача',description:'Помогаю разместить согласованные материалы и передаю исходники в рамках проекта.',result:'Готовые площадки и материалы'}];
---
<Base>
<main>
<section class="hero hero-new offer-hero" id="home"><div class="hero-text"><h1><span>Помогу клиентам</span><span>найти и выбрать</span><span>ваш бизнес</span></h1><p>Сайт, карты и соцсети в единой системе: объясняют ценность ваших услуг, вызывают доверие и помогают клиентам обратиться.</p><div class="hero-actions"><a class="button offer-primary" href="#contact"><span>Получить бесплатный разбор</span></a><a class="hero-link offer-secondary" href="#work"><span>Смотреть работы</span></a></div><p class="hero-proof">Напрямую со мной · Согласованная цена · Старт от 7 дней для небольших задач</p></div><figure class="hero-stage hero-image offer-image"><div class="hero-render" role="img" aria-label="Стеклянный куб с металлическими символами сайта, карт и социальных сетей"></div></figure></section>
<section class="section light marketing-pains"><div class="section-head"><h2>Клиенты находят вас.<br/>Но выбирают ли?</h2><p class="lead">Даже хороший бизнес может проигрывать конкурентам, если его сложно понять в интернете.</p></div><div class="benefits"><article><h3>На картах</h3><p>Неясные услуги, старые фото и скрытый прайс мешают выбрать вас среди соседних компаний.</p></article><article><h3>В соцсетях</h3><p>Покупатель не видит ответов на свои вопросы и не понимает, почему стоит обратиться именно к вам.</p></article><article><h3>На сайте</h3><p>Сложная навигация и общие обещания мешают узнать стоимость и сделать следующий шаг.</p></article></div></section><section class="section marketing-system"><div class="section-head"><h2>Не три площадки.<br/>Одна система.</h2><p class="lead">Каждая площадка решает свою задачу на пути от поиска до обращения.</p></div><div class="benefits"><article><h3>01 / Найти</h3><p>Карты: заметное, информативное присутствие рядом с клиентом.</p></article><article><h3>02 / Довериться</h3><p>ВКонтакте: живые ответы, полезный контент и понятные услуги.</p></article><article><h3>03 / Выбрать</h3><p>Сайт: аргументы, стоимость, примеры и простой переход к общению.</p></article></div><a class="button" href="#contact">Разобрать мой бизнес</a></section><section id="work" class="section light"><div class="section-head"><h2 data-reveal>Работы</h2><p class="lead" data-reveal>Посмотрите, как разные площадки помогают решить конкретные задачи бизнеса.</p></div><div class="filters" aria-label="Фильтр работ">{categories.map((c,i)=><button data-filter={c} aria-pressed={i===0}>{c}</button>)}</div><div class="project-grid">{projects.map(project=><a class="project" href={base+'/work/'+project.slug+'/'} data-categories={project.types.join('|')} data-reveal><ProjectCover project={project}/><div class="project-caption"><div><h3>{project.name}</h3><span>{project.card}</span></div></div></a>)}</div></section>
<section id="about" class="section about"><div class="about-intro"><h2 data-reveal>Обо мне</h2><div class="about-statement" data-reveal><h3>От первого разговора до готового проекта — работаем напрямую</h3><p>Я занимаюсь цифровой упаковкой бизнеса: изучаю задачу, проектирую и оформляю сайты, карты и соцсети. Вы общаетесь лично со мной и знаете, кто отвечает за результат.</p></div></div><div class="about-cards"><article class="about-card" data-reveal><div class="about-graphic graphic-focus" aria-hidden="true"><i></i><i></i><i></i><span></span></div><h3>Понимаю задачу</h3><p>Смотрю на бизнес глазами ваших клиентов и предлагаю подходящий формат работы.</p></article><article class="about-card" data-reveal><div class="about-graphic graphic-system" aria-hidden="true"><i></i><i></i><i></i></div><h3>Собираю в систему</h3><p>Все площадки оформлены в одном стиле и дополняют друг друга.</p></article><article class="about-card" data-reveal><div class="about-graphic graphic-process" aria-hidden="true"><i></i><i></i><i></i><span></span></div><h3>Держу в курсе</h3><p>Вы знаете, что происходит с проектом, сколько это стоит и когда будет готово.</p></article></div></section>
<section class="section light" id="services"><div class="section-head"><h2 data-reveal>Услуги</h2><p class="lead" data-reveal>Ориентиры по бюджету. Подберём подходящий объём работ после знакомства с бизнесом.</p></div><div class="packages">{packages.map((pkg,i)=><article class:list={['package',{'package-full':i===2}]} data-reveal><div class="package-art" aria-hidden="true"><span class="tier-icon"><svg viewBox="0 0 30 30"><path d="M15 27s8-9 8-16a8 8 0 1 0-16 0c0 7 8 16 8 16Z"/><circle cx="15" cy="11" r="3"/></svg></span>{i>=1&&<span class="tier-icon"><svg viewBox="0 0 30 30"><rect x="4" y="4" width="22" height="22" rx="4"/><circle cx="11" cy="11" r="3"/><path d="M17 10h5M17 14h5M8 19h14M8 22h9"/></svg></span>}{i===2&&<span class="tier-icon"><svg viewBox="0 0 30 30"><rect x="3" y="5" width="24" height="20" rx="3"/><path d="M3 11h24M8 8h.1M11 8h.1M15 15h8M15 19h8"/><rect x="7" y="15" width="4" height="6" rx="1"/></svg></span>}</div><h3>{pkg.name}</h3><p class="package-description">{pkg.description}</p><strong class="package-price"><span class="price-from">от</span> {pkg.price}</strong><dl>{features.map((label,j)=>pkg.features[j]!=='—'&&<div class:list={['package-row',{'not-included':pkg.features[j]==='—'}]}><span aria-hidden="true">{pkg.features[j]==='—'?'−':'✓'}</span><dt>{label}</dt><dd>{pkg.features[j]==='—'?'Не входит':pkg.features[j]}</dd></div>)}</dl><a class="package-action" href="#contact">Обсудить этот пакет</a></article>)}</div><p class="package-note">Стартовая стоимость зависит от задачи. После знакомства с бизнесом подготовлю персональное предложение: состав работ, сроки и итоговая цена.</p><div class="extra-services"><h3 class="extra-title">Отдельные услуги</h3><div class="services">{extras.map(([name,description,price])=><article class="service" data-reveal><h3>{name}</h3><p>{description}</p><strong>{price}</strong></article>)}</div></div></section>
<section class="section process" id="process"><div class="section-head"><h2 data-reveal>Как работаю</h2><p class="lead" data-reveal>Четыре этапа от первого разговора до готового проекта.</p></div><div class="process-scroll" id="process-scroll"><div class="process-layout" id="process-layout" data-reveal><div class="process-visual" aria-hidden="true"><div class="process-number"><span id="step-number">01</span><span class="process-total">/ 04</span></div><div class="process-track"><div class="process-fill" id="process-fill"></div></div><div class="process-shapes" id="process-shapes" data-stage="0"><i></i><i></i><i></i><i></i></div></div><div class="process-steps">{steps.map((step,i)=><article class:list={['process-step',{'active':i===0}]}><button class="step-trigger" aria-expanded={i===0} aria-controls={'step-panel-'+i} data-step={i}><span class="step-index">0{i+1}</span><span>{step.title}</span><span class="step-plus" aria-hidden="true"></span></button><div class="step-panel" id={'step-panel-'+i} aria-hidden={i!==0}><div><p>{step.description}</p><p class="step-result"><strong>На выходе:</strong> {step.result}</p></div></div></article>)}</div></div></div></section>
<section class="section light faq-section" id="faq"><div class="section-head"><h2 data-reveal>Частые вопросы</h2></div><div class="faq-layout"><div class="faq-intro"><p>Всё важное о работе, сроках и стоимости. Остальное обсудим лично.</p><a href="#contact">Задать вопрос</a></div><div class="faq-list">{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</main>
<script>const filters=document.querySelectorAll('[data-filter]');const projects=document.querySelectorAll('.project');filters.forEach(btn=>btn.addEventListener('click',()=>{filters.forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));projects.forEach(p=>{p.hidden=btn.dataset.filter!=='Все'&&!p.dataset.categories.split('|').includes(btn.dataset.filter);if(!p.hidden)p.classList.add('in')})}));
const stepButtons=document.querySelectorAll<HTMLButtonElement>('.step-trigger');const number=document.querySelector<HTMLElement>('#step-number');const fill=document.querySelector<HTMLElement>('#process-fill');const shapes=document.querySelector<HTMLElement>('#process-shapes');const track=document.querySelector<HTMLElement>('#process-scroll');const layout=document.querySelector<HTMLElement>('#process-layout');const scrollScene=matchMedia('(min-width: 901px) and (min-height: 650px) and (prefers-reduced-motion: no-preference)');let currentStep=0;let ticking=false;
function activateStep(i:number){if(i===currentStep)return;const previous=currentStep;currentStep=i;stepButtons.forEach((b,index)=>{const active=index===i;b.setAttribute('aria-expanded',String(active));b.closest('.process-step')?.classList.toggle('active',active);document.getElementById(b.getAttribute('aria-controls')||'')?.setAttribute('aria-hidden',String(!active))});if(number){const nextValue=String(i+1).padStart(2,'0');if(matchMedia('(prefers-reduced-motion: reduce)').matches){number.textContent=nextValue}else{const old=document.createElement('span');old.className='counter-old';old.textContent=String(previous+1).padStart(2,'0');const next=document.createElement('span');next.className='counter-new';next.textContent=nextValue;number.replaceChildren(old,next);old.animate([{opacity:1,transform:'translateY(0)'},{opacity:0,transform:'translateY(-12px)'}],{duration:600,easing:'cubic-bezier(.22,.61,.36,1)',fill:'forwards'});next.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],{duration:850,easing:'cubic-bezier(.22,.61,.36,1)',fill:'both'});}}if(fill)fill.style.width=((i+1)*25)+'%';if(shapes)shapes.dataset.stage=String(i)}
function sceneMetrics(){if(!track||!layout)return null;const top=parseFloat(getComputedStyle(layout).top)||0;const travel=Math.max(1,track.offsetHeight-layout.offsetHeight);return {top,travel,rect:track.getBoundingClientRect()}}
function updateScene(){ticking=false;if(!scrollScene.matches)return;const m=sceneMetrics();if(!m)return;const progress=Math.max(0,Math.min(1,(m.top-m.rect.top)/m.travel));activateStep(Math.min(3,Math.floor(progress*4)))}
function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(updateScene)}}
stepButtons.forEach((btn,i)=>btn.addEventListener('click',()=>{if(scrollScene.matches){const m=sceneMetrics();if(m){window.scrollTo({top:window.scrollY+m.rect.top-m.top+m.travel*((i+.45)/4),behavior:'smooth'});return}}activateStep(i)}));window.addEventListener('scroll',onScroll,{passive:true});window.addEventListener('resize',onScroll);scrollScene.addEventListener('change',onScroll);updateScene();</script>
</Base>
