---
import Icon from '../components/MarketingIcon.astro';
import HomeSalesSections from '../components/HomeSalesSections.astro';
import '../styles/home-sales.css';
import Base from '../layouts/Base.astro';
import ProjectCover from '../components/ProjectCover.astro';
import {projects,categories} from '../data/projects.js';
const caseCaptions={"detail":"Помогаем выбрать подходящий уход за автомобилем.","window-service":"Объясняем, когда выгоднее ремонт, а когда — установка.","vysota":"Раскрываем состав сметы и помогаем выбрать свет.","mac-more":"Ассортимент и условия покупки — в понятной витрине.","ai-ray":"Помогаем ориентироваться в предложениях магазина.","furniture":"Разделяем ассортимент по задачам покупателя."};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const faq=[["Гарантируешь рост заявок?","На количество обращений влияют спрос, видимость площадок, цены и работа с клиентами. Я улучшаю представление бизнеса, чтобы покупателю было проще выбрать и обратиться. Эффект оцениваем после запуска."],["Нужно ли оформлять все площадки сразу?","Нет. Начнём с разбора и определим приоритет. Можно заказать отдельную услугу."],["Что, если сайт или группа уже есть?","Посмотрю действующие материалы. Возможно, достаточно улучшить содержание, дизайн или часть структуры."],["У меня нет текстов, фотографий или фирменного стиля. Что делать?","Начнём с информации о бизнесе. Определим, какие реальные материалы нужны и что можно разработать в рамках проекта."],["Сколько времени занимает работа?","От 7 дней для небольшого проекта. Срок зависит от объёма, готовности материалов и скорости согласований. Точный график предложу после обсуждения."],["Что нужно от меня для начала?","Расскажите о бизнесе, целях и текущих площадках. Если есть фотографии, фирменный стиль или прайс, пришлите их. Список недостающих материалов определим вместе."],["Можно ли заказать только одну услугу?","Да. Можно отдельно оформить карты, сообщество ВКонтакте, сайт или заказать сопровождение."],["Как формируется стоимость?","На сайте указаны стартовые цены. После знакомства с бизнесом подготовлю персональное предложение с составом работ, этапами, сроками и итоговой стоимостью."],["Сколько правок входит в работу?","До двух раундов правок в согласованном объёме. Дополнительные изменения предварительно обсудим."],["Помогаешь ли ты с размещением материалов?","Да, помогаю разместить согласованные материалы на площадках и передаю исходники в рамках проекта."],["Можно ли заказать дальнейшее сопровождение?","Да. Обновляю информацию, товары, акции и визуальные материалы. Объём и периодичность согласуем отдельно."],["Как происходит оплата?","Условия и график оплаты зафиксируем в персональном предложении до начала работы."]];
const packages=[
  {name:'Карты',price:'12 900 ₽',description:'Если покупатели ищут вас рядом и сравнивают с соседними компаниями.',features:['Анализ, описание, услуги, визуалы для Яндекс Карт и 2ГИС','—','—','—']},
  {name:'Карты + ВК',price:'29 900 ₽',description:'Если клиенты находят бизнес через поиск и хотят узнать больше до обращения.',features:['Анализ, каталог и визуалы','Обложки, аватар, меню, виджеты, услуги и стартовые публикации','—','—']},
  {name:'Комплекс',price:'69 900 ₽',description:'Если нужно выстроить целостное присутствие бизнеса в интернете.',features:['Анализ, каталог и визуалы','Обложки, аватар, меню, виджеты, услуги и стартовые публикации','Адаптивный сайт: услуги, аргументы, контакты','По задаче бизнеса']}
];
const features=['Карты','ВКонтакте','Сайт','Доп. площадка'];
const extras=[['Сайт-визитка','Страница с главной информацией о бизнесе и переходом в мессенджер','от 29 900 ₽'],['Индивидуальный лендинг','Отдельный дизайн и структура под задачу бизнеса','от 45 000 ₽'],['Многостраничный сайт','Структура страниц и базовая SEO-подготовка','от 80 000 ₽'],['Сопровождение','Обновление информации и материалов на площадках','от 9 900 ₽/мес']];
const steps=[{title:'Знакомство и аудит',description:'Обсуждаем ваш бизнес. Изучаю действующие площадки, услуги и то, как клиенты вас находят.',result:'Понятная задача и согласованный объём работ'},{title:'Структура и идея',description:'Определяю, какую информацию нужно показать, как её организовать и каким должен быть визуальный стиль.',result:'Структура и согласованное визуальное направление'},{title:'Дизайн и согласование',description:'Оформляю материалы, показываю промежуточный результат и вношу согласованные правки.',result:'Готовые визуалы и макеты'},{title:'Запуск и передача',description:'Помогаю разместить согласованные материалы и передаю исходники в рамках проекта.',result:'Готовые площадки и материалы'}];
---
<Base>
<main class="sales-home">
<section class="hero hero-new offer-hero" id="home"><div class="hero-text"><h1>Помогаю клиентам <span>выбирать ваш бизнес<span class="hero-comma">,</span></span> а не конкурентов</h1><p>Оформляю сайты, Яндекс Карты, 2ГИС и ВКонтакте. Разбираюсь в вашем предложении, пишу тексты и собираю визуалы в единую систему — чтобы покупателю было легче выбрать вас.</p><div class="hero-actions"><a class="button offer-primary" href="#contact"><span>Получить бесплатный разбор</span></a><a class="hero-link offer-secondary" href="#work"><span>Смотреть работы</span></a></div><div class="hero-proofs"><span><Icon name="person"/>Напрямую со мной</span><span><Icon name="check"/>Согласованная цена</span><span><Icon name="clock"/>Небольшие проекты от 7 дней</span></div></div><figure class="hero-stage hero-image offer-image"><div class="hero-render" role="img" aria-label="Стеклянный куб с металлическими символами сайта, карт и социальных сетей"></div></figure></section>
<HomeSalesSections part="pain" {base}/><section id="work" class="section light"><div class="section-head"><h2 data-reveal>Работы, которые <span class="sales-muted">решают задачи бизнеса</span></h2><p class="lead" data-reveal>Каждая ниша требует своих аргументов. Посмотрите, как они превращаются в сайт, карты и ВКонтакте.</p></div><div class="filters" aria-label="Фильтр работ">{categories.map((c,i)=><button data-filter={c} aria-pressed={i===0}>{c}</button>)}</div><div class="project-grid">{projects.map(project=><a class="project" href={base+'/work/'+project.slug+'/'} data-categories={project.types.join('|')} data-reveal><ProjectCover project={project}/><div class="project-caption"><div><h3>{project.name}</h3><span>{caseCaptions[project.slug]||project.card}</span></div></div></a>)}</div><div class="work-cta"><p>Есть похожая задача? Подберём решение под вашу нишу.</p><a class="button" href="#contact">Обсудить мой бизнес</a></div></section>
<HomeSalesSections part="system" {base}/><HomeSalesSections part="method" {base}/><HomeSalesSections part="audit" {base}/>
<section class="section light" id="services"><div class="section-head"><h2 data-reveal>Начните с площадки, <span class="sales-muted">которая сейчас важнее</span></h2><p class="lead" data-reveal>Не всем нужен полный комплекс. Выберите одну площадку, две точки контакта или всю систему.</p></div><div class="packages">{packages.map((pkg,i)=><article class:list={['package',{'package-full':i===2}]} data-reveal><div class="package-art package-photo"><img src={base+'/images/packages/tier-'+i+'.webp'} alt="" loading="lazy"/></div><h3>{pkg.name}</h3><p class="package-description">{pkg.description}</p><strong class="package-price"><span class="price-from">от</span> {pkg.price}</strong><dl>{features.map((label,j)=>pkg.features[j]!=='—'&&<div class:list={['package-row',{'not-included':pkg.features[j]==='—'}]}><span aria-hidden="true">{pkg.features[j]==='—'?'−':'✓'}</span><dt>{label}</dt><dd>{pkg.features[j]==='—'?'Не входит':pkg.features[j]}</dd></div>)}</dl><div class="package-result"><small>На выходе</small><p>{["Понятная карточка с актуальной информацией для выбора.","Две площадки с единым предложением и аргументами.","Готовая система площадок с понятным способом обратиться."][i]}</p></div><a class="package-action" href="#contact">{["Обсудить карты","Обсудить карты и ВК","Обсудить комплекс"][i]}</a></article>)}</div><p class="package-note">Стартовая стоимость зависит от задачи. После знакомства с бизнесом подготовлю персональное предложение: состав работ, сроки и итоговая цена.</p><div class="extra-services"><h3 class="extra-title">Нужна только одна услуга?</h3><div class="services">{extras.map(([name,description,price])=><article class="service" data-reveal><h3>{name}</h3><p>{description}</p><strong>{price}</strong></article>)}</div></div></section>
<section class="section sales-about" id="about"><div class="about-sales-intro"><div><span class="sales-eyebrow">07 / Работа напрямую</span><h2>Вы общаетесь со мной, <span>а не с цепочкой менеджеров</span></h2></div><div class="about-name"><img class="about-portrait" src={base+'/images/artem-portrait.webp'} alt="Артём Кузнецов" width="88" height="88" loading="lazy"/><div><h3>Артём Кузнецов</h3><p>Дизайн, структура, тексты и оформление площадок.</p></div></div></div><div class="sales-trust-grid">{[["user-check","Один ответственный человек","Общаемся и согласуем решения напрямую."],["clipboard","Понятный объём работы","До старта обсуждаем состав, сроки и стоимость."],["folder","Материалы остаются у вас","Передаю согласованные материалы и исходники в рамках проекта."]].map(([icon,title,desc])=><article data-reveal><div class="trust-icon"><Icon name={icon}/></div><h3>{title}</h3><p>{desc}</p></article>)}</div></section>
<section class="section process" id="process"><div class="section-head"><h2 data-reveal>Вы заранее знаете, <span class="sales-muted">как будет идти проект</span></h2><p class="lead" data-reveal>Четыре этапа с понятным результатом. Ваше участие — в обсуждении задачи и согласованиях.</p></div><div class="process-scroll" id="process-scroll"><div class="process-layout" id="process-layout" data-reveal><div class="process-visual" aria-hidden="true"><div class="process-number"><span id="step-number">01</span><span class="process-total">/ 04</span></div><div class="process-track"><div class="process-fill" id="process-fill"></div></div><div class="process-shapes" id="process-shapes" data-stage="0"><i></i><i></i><i></i><i></i></div></div><div class="process-steps">{steps.map((step,i)=><article class:list={['process-step',{'active':i===0}]}><button class="step-trigger" aria-expanded={i===0} aria-controls={'step-panel-'+i} data-step={i}><span class="step-index">0{i+1}</span><span>{step.title}</span><span class="step-plus" aria-hidden="true"></span></button><div class="step-panel" id={'step-panel-'+i} aria-hidden={i!==0}><div><p>{step.description}</p><p class="step-result"><strong>На выходе:</strong> {step.result}</p></div></div></article>)}</div></div></div></section>
<section class="section light faq-section" id="faq"><div class="section-head"><h2 data-reveal>Что важно знать <span class="sales-muted">до начала работы</span></h2></div><div class="faq-layout"><div class="faq-intro"><p>Всё важное о работе, сроках и стоимости. Остальное обсудим лично.</p><a href="#contact">Задать вопрос</a></div><div class="faq-list">{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</main>
<script>const filters=document.querySelectorAll('[data-filter]');const projects=document.querySelectorAll('.project');filters.forEach(btn=>btn.addEventListener('click',()=>{filters.forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));projects.forEach(p=>{p.hidden=btn.dataset.filter!=='Все'&&!p.dataset.categories.split('|').includes(btn.dataset.filter);if(!p.hidden)p.classList.add('in')})}));
const stepButtons=document.querySelectorAll<HTMLButtonElement>('.step-trigger');const number=document.querySelector<HTMLElement>('#step-number');const fill=document.querySelector<HTMLElement>('#process-fill');const shapes=document.querySelector<HTMLElement>('#process-shapes');const track=document.querySelector<HTMLElement>('#process-scroll');const layout=document.querySelector<HTMLElement>('#process-layout');const scrollScene=matchMedia('(min-width: 901px) and (min-height: 650px) and (prefers-reduced-motion: no-preference)');let currentStep=0;let ticking=false;
function activateStep(i:number){if(i===currentStep)return;const previous=currentStep;currentStep=i;stepButtons.forEach((b,index)=>{const active=index===i;b.setAttribute('aria-expanded',String(active));b.closest('.process-step')?.classList.toggle('active',active);document.getElementById(b.getAttribute('aria-controls')||'')?.setAttribute('aria-hidden',String(!active))});if(number){const nextValue=String(i+1).padStart(2,'0');if(matchMedia('(prefers-reduced-motion: reduce)').matches){number.textContent=nextValue}else{const old=document.createElement('span');old.className='counter-old';old.textContent=String(previous+1).padStart(2,'0');const next=document.createElement('span');next.className='counter-new';next.textContent=nextValue;number.replaceChildren(old,next);old.animate([{opacity:1,transform:'translateY(0)'},{opacity:0,transform:'translateY(-12px)'}],{duration:600,easing:'cubic-bezier(.22,.61,.36,1)',fill:'forwards'});next.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],{duration:850,easing:'cubic-bezier(.22,.61,.36,1)',fill:'both'});}}if(fill)fill.style.width=((i+1)*25)+'%';if(shapes)shapes.dataset.stage=String(i)}
function sceneMetrics(){if(!track||!layout)return null;const top=parseFloat(getComputedStyle(layout).top)||0;const travel=Math.max(1,track.offsetHeight-layout.offsetHeight);return {top,travel,rect:track.getBoundingClientRect()}}
function updateScene(){ticking=false;if(!scrollScene.matches)return;const m=sceneMetrics();if(!m)return;const progress=Math.max(0,Math.min(1,(m.top-m.rect.top)/m.travel));activateStep(Math.min(3,Math.floor(progress*4)))}
function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(updateScene)}}
stepButtons.forEach((btn,i)=>btn.addEventListener('click',()=>{if(scrollScene.matches){const m=sceneMetrics();if(m){window.scrollTo({top:window.scrollY+m.rect.top-m.top+m.travel*((i+.45)/4),behavior:'smooth'});return}}activateStep(i)}));window.addEventListener('scroll',onScroll,{passive:true});window.addEventListener('resize',onScroll);scrollScene.addEventListener('change',onScroll);updateScene();</script>
</Base>
