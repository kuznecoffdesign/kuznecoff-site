---
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import {projects} from '../../data/projects.js';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}))}
const {project,next}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const galleryPath=(file)=>`${base}/images/cases/${project.slug}/${file}`;
---
<Base title={project.name+' — Артём Кузнецов'} description={project.description}>
<main class="case"><a class="case-return" href={base+'/#work'}>← Все работы</a><ProjectCover project={project} large/><section class="section case-intro"><a class="back" href={base+'/#work'}>Все работы</a><div class="section-head"><div><p class="kicker">{project.industry}</p><h1 data-reveal>{project.name}</h1></div><div><p class="lead">{project.description}</p><p class="small muted">{project.types.join(' / ')} · {project.year}</p></div></div><nav class="case-index"><a href="#task">Задача</a><a href="#decisions">Что сделано</a>{project.demos&&<a href="#demo">Посмотреть проект</a>}<a href="#system">Материалы</a><a href="#result">Результат</a></nav></section>
<section id="task" class="section light"><h2 data-reveal>{project.headline}</h2><div class="about-copy"><p class="lead" data-reveal>{project.problem}</p><div data-reveal><p>{project.task}</p><p style="margin-top:16px">{project.role}</p></div></div></section>
<section id="decisions" class="section"><h2 data-reveal>{project.gallery ? "Что сделано" : "Решения"}</h2><div class="benefits">{project.decisions.map(([h,t])=><article data-reveal><h3>{h}</h3><p>{t}</p></article>)}</div></section>
{project.demos&&<section id="demo" class="section light"><div class="section-head"><h2 data-reveal>Посмотреть<br/>проект</h2><p class="lead">Откройте каждую площадку и посмотрите, как она помогает клиенту понять предложение бизнеса.</p></div><div class="demo-grid">{project.demos.map(d=><a class="demo-card" href={base+d.path} data-reveal><div class:list={['demo-thumb',{'demo-artwork':d.thumbnail==='artwork'}]}><img src={galleryPath(d.image)} alt="" loading="lazy"/></div><div class="demo-card-body"><h3>{d.title}</h3><p>{d.description}</p><span>Открыть</span></div></a>)}</div></section>}
<section id="system" class="section light"><div class="section-head"><h2 data-reveal>{project.gallery ? "Оригинальные материалы" : "Визуальная система"}</h2><p class="lead">{project.gallery ? (project.demos ? "Материалы для разных площадок, объединённые общей визуальной системой." : "Готовые материалы для карточки: обложки, витрина и визуалы ключевых разделов.") : "Черновая реконструкция структуры кейса. Здесь появятся оригинальные визуалы и мокапы."}</p></div>{project.gallery ? <div class:list={['case-gallery',{'case-gallery--mixed':project.coverStyle==='mixed'}]}>{project.gallery.map(([file,label,kind])=><figure class:list={['case-artwork',{'gallery-wide':kind==='wide','gallery-square':kind==='square'}]} data-reveal><a href={galleryPath(file)} target="_blank" rel="noopener"><img src={galleryPath(file)} alt={label} loading="lazy" decoding="async"/></a><figcaption>{label}</figcaption></figure>)}</div> : <><div class="palette">{project.palette.map(color=><div style={'background:'+color}><span>{color}</span></div>)}</div><div class={'mock-grid '+project.theme}>{project.labels.map((label)=><div class="mock" data-reveal><span>{project.name}</span><b>{label}</b><small>Эскиз структуры</small></div>)}</div></>}</section>
<section id="result" class="section"><h2 data-reveal>Что получает бизнес</h2><p class="lead" data-reveal>{project.outcome}</p><p class="small muted" style="margin-top:20px">{project.note}</p><div class="case-cta"><h3>Хотите подобное решение для своего бизнеса?</h3><p>Начнём с разбора ваших площадок и подберём нужный объём работы.</p><a class="button" href="#contact">Получить бесплатный разбор</a></div></section>
<section class="section light next"><p class="lead">Следующий проект</p><a href={base+'/work/'+next.slug+'/'}><h2>{next.name}</h2><ProjectCover project={next}/></a></section></main>
</Base>
