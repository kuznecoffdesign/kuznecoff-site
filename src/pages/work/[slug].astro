---
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import {projects} from '../../data/projects.js';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}))}
const {project,next}=Astro.props;
---
<Base title={project.name+' — Артём Кузнецов'} description={project.description}>
<main class="case"><ProjectCover project={project} large/><section class="section case-intro"><a class="back" href="/#work">Все работы</a><div class="section-head"><div><p class="kicker">{project.industry} / {project.status}</p><h1 data-reveal>{project.name}</h1></div><div><p class="lead">{project.description}</p><p class="small muted">{project.types.join(' / ')} · {project.year}</p></div></div><nav class="case-index"><a href="#task">Задача</a><a href="#decisions">Решения</a><a href="#system">Система</a><a href="#result">Результат</a></nav></section>
<section id="task" class="section light"><h2 data-reveal>{project.headline}</h2><div class="about-copy"><p class="lead" data-reveal>{project.task}</p><div data-reveal><p>{project.role}</p></div></div></section>
<section id="decisions" class="section"><h2 data-reveal>Решения</h2><div class="benefits">{project.decisions.map(([h,t])=><article data-reveal><h3>{h}</h3><p>{t}</p></article>)}</div></section>
<section id="system" class="section light"><div class="section-head"><h2 data-reveal>Визуальная система</h2><p class="lead">Черновая реконструкция структуры кейса. Здесь появятся оригинальные визуалы и мокапы.</p></div><div class="palette">{project.palette.map(color=><div style={'background:'+color}><span>{color}</span></div>)}</div><div class={'mock-grid '+project.theme}>{project.labels.map((label,i)=><div class="mock" data-reveal><span>{project.name}</span><b>{label}</b><small>Эскиз структуры</small></div>)}</div></section>
<section id="result" class="section"><h2 data-reveal>Статус проекта</h2><p class="lead" data-reveal>{project.note}</p></section>
<section class="section light next"><p class="lead">Следующий проект</p><a href={'/work/'+next.slug+'/'}><h2>{next.name}</h2><ProjectCover project={next}/></a></section></main>
</Base>
