---
const {data,asset}=Astro.props;
const symptoms=[['Сквозняк','Холод у рамы или подоконника','Проверим прилегание, уплотнитель и монтажный шов.','post-0.webp'],['Запотевание','Влага на стекле или внутри пакета','Разберёмся, где появляется конденсат и нужна ли замена.','post-1.webp'],['Заедает ручка','Створка цепляет раму или не закрывается','Проверим регулировку и запирающий механизм.','post-2.webp']];
---
<div class="window-pro" id="top"><header class="wp-nav"><a class="wp-brand" href="#top"><img src={asset('avatar.webp')} alt=""/><span>Тепло дома<small>Оконный сервис</small></span></a><nav><a href="#symptoms">Проблемы</a><a href="#services">Услуги</a><a href="#estimate">Стоимость</a><a href="#faq">Вопросы</a></nav><a class="wp-primary" href="#estimate">Рассчитать ремонт</a></header><main><section class="wp-hero"><div class="wp-hero-copy"><span class="wp-tag">Установка и ремонт пластиковых окон</span><h1>Вернём тепло<br/>в ваш дом<span>Установим новые окна или восстановим существующие</span></h1><p>Нужны новые окна или беспокоят сквозняки? Подберём решение, объясним варианты и согласуем стоимость перед работами.</p><div class="wp-actions"><a class="wp-primary" href="#estimate">Узнать стоимость</a><a class="wp-secondary" href="#symptoms">Найти свою проблему</a></div><div class="wp-proof"><span>✓ Согласуем смету</span><span>✓ Объясним работы</span></div></div><div class="wp-hero-picture"><img src={asset('technician.webp')} alt="Мастер ремонтирует окно в квартире"/><div><b>Ремонт вместо лишних расходов</b><small>Сначала проверяем причину</small></div></div></section><section class="wp-section wp-problems" id="symptoms"><div class="wp-heading"><div><span class="wp-tag">Проверьте симптом</span><h2>Знакомая ситуация?</h2></div><p>Неисправности бывают похожими. Правильный ремонт начинается с выяснения причины.</p></div><div class="wp-triple">{symptoms.map(([name,lead,desc,file])=><article><img src={asset(file)} alt={name}/><div><h3>{name}</h3><b>{lead}</b><p>{desc}</p></div></article>)}</div></section><section class="wp-section" id="services"><div class="wp-heading"><div><span class="wp-tag">Каталог работ</span><h2>Что можем сделать</h2></div><p>Стоимость указана для ориентира. Состав работ определяем после осмотра.</p></div><div class="wp-services">{data.services.map(([name,desc,price],i)=><article><img src={asset('service-'+i+'.webp')} alt={name}/><div><h3>{name}</h3><p>{desc}</p><strong>{price}</strong></div><a href="#estimate" aria-label={'Рассчитать '+name}>↗</a></article>)}</div></section><section class="wp-section wp-estimate" id="estimate"><div><span class="wp-tag">Калькулятор</span><h2>Прикинем бюджет ремонта</h2><p>Выберите вид работ и количество. Расчёт предварительный: расходные материалы, сложность и необходимые детали могут изменить цену.</p><img src={asset('render-0.webp')} alt="Визуализация оконной фурнитуры"/></div><div class="wp-calc"><label for="repair-kind">Вид работ</label><select id="repair-kind"><option value="900">Регулировка створки · 900 ₽</option><option value="350">Замена уплотнителя · 350 ₽/м</option><option value="1500">Ремонт фурнитуры · 1 500 ₽</option><option value="0">Замена стеклопакета · по замеру</option><option value="0">Установка окна · по замеру</option></select><label for="repair-qty" id="qty-label">Количество створок</label><input id="repair-qty" type="number" min="1" max="40" value="2" step="1"/><div class="wp-total"><span>Предварительно от</span><strong id="repair-total" aria-live="polite">1 800 ₽</strong></div><a class="wp-primary" href="#contact">Обсудить расчёт</a><small>Демонстрационные цены, не публичная оферта.</small></div></section><section class="wp-section wp-why"><div class="wp-heading"><div><span class="wp-tag">Почему такой подход</span><h2>Ремонт с пониманием задачи</h2></div><p>Вы знаете, что меняется и зачем.</p></div><div class="wp-triple"><article><div><span class="wp-icon">✓</span><h3>Без лишних работ</h3><p>Если достаточно регулировки, не предлагаем менять окно целиком.</p></div></article><article><div><span class="wp-icon">₽</span><h3>Понятная стоимость</h3><p>Согласуем нужные материалы и работы до начала ремонта.</p></div></article><article><div><span class="wp-icon">↗</span><h3>Проверка результата</h3><p>После работы проверяем ход створки и согласованную неисправность.</p></div></article></div></section><section class="wp-section wp-process"><img src={asset('post-3.webp')} alt="Диагностика окна"/><div><span class="wp-tag">Как работаем</span><h2>Три шага до решения</h2>{[['Опишите проблему','Пришлите фото и расскажите, что беспокоит.'],['Диагностика и смета','Определяем причину, согласуем работы.'],['Ремонт и проверка','Выполняем ремонт и проверяем результат.']].map(([h,p],i)=><article><span>0{i+1}</span><div><h3>{h}</h3><p>{p}</p></div></article>)}</div></section><section class="wp-section" id="faq"><div class="wp-heading"><h2>Частые вопросы</h2><p>Перед обращением — самое важное.</p></div>{data.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section class="wp-contact" id="contact"><div><span class="wp-tag">Первый шаг</span><h2>Расскажите, что случилось с окном</h2><p>Фото и описание помогут понять, с чего начать.</p></div><button class="wp-primary" disabled>Написать в мессенджер</button></section></main></div>
<script>const k=document.querySelector<HTMLSelectElement>('#repair-kind'),q=document.querySelector<HTMLInputElement>('#repair-qty'),t=document.querySelector<HTMLElement>('#repair-total'),label=document.querySelector<HTMLElement>('#qty-label');function recalc(){if(!k||!q||!t||!label)return;const rate=Number(k.value);label.textContent=rate===350?'Длина уплотнителя, м':rate===1500?'Количество механизмов':'Количество створок';q.disabled=rate===0;t.textContent=rate?new Intl.NumberFormat('ru-RU').format(rate*Math.max(1,Math.min(40,Math.floor(Number(q.value)||1))))+' ₽':'По замеру'}[k,q].forEach(el=>el?.addEventListener('input',recalc));recalc();</script>
<style is:global>.window-pro{--navy:#132e46;--blue:#2166aa;--paper:#f5f8fa;color:var(--navy);background:var(--paper);font:17px/1.55 Arial,sans-serif}.window-pro *{box-sizing:border-box}.window-pro a{color:inherit;text-decoration:none}.window-pro h1,.window-pro h2,.window-pro h3,.window-pro p{margin:0}.window-pro h1,.window-pro h2,.window-pro h3{letter-spacing:-.04em;line-height:1.08}.window-pro h2{font-size:clamp(34px,4.1vw,58px)}.window-pro h3{font-size:clamp(21px,2.1vw,29px)}.window-pro p{color:#536a7e}.window-pro img{display:block;width:100%;object-fit:cover}.wp-nav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 5vw;background:white;border-bottom:1px solid #dce4ea}.wp-brand{display:flex;gap:12px;align-items:center;font-size:23px;font-weight:700;white-space:nowrap}.wp-brand img{width:44px;height:44px;border-radius:9px}.wp-brand small{display:block;color:#607489;font-size:12px;line-height:1.1;font-weight:400}.wp-nav nav{display:flex;align-items:center;gap:25px;font-size:15px}.wp-primary,.wp-secondary{display:inline-flex;justify-content:center;align-items:center;padding:15px 22px;border-radius:12px;border:1px solid var(--blue);font:600 15px Arial,sans-serif;white-space:nowrap}.window-pro .wp-primary{background:var(--blue);color:#fff}.wp-secondary{color:var(--blue);background:transparent}.wp-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.95fr);align-items:center;gap:4vw;padding:clamp(38px,6vw,95px) 5vw}.wp-hero-copy{display:grid;gap:22px;justify-items:start}.wp-tag{display:inline-flex;color:#2866a3;background:#e6f0fa;border-radius:30px;padding:7px 12px;font-size:12px;letter-spacing:.035em;font-weight:700}.wp-hero h1{font-size:clamp(43px,5.5vw,82px)}.wp-hero h1 span{display:block;font-size:clamp(23px,2.65vw,39px);line-height:1.15;color:#5c7388;margin-top:14px;font-weight:500}.wp-hero-copy p{max-width:500px;font-size:19px}.wp-actions,.wp-proof{display:flex;gap:10px;flex-wrap:wrap}.wp-proof span{font-size:13px;background:#e8f0f7;color:#315774;padding:7px 11px;border-radius:20px}.wp-hero-picture{position:relative;aspect-ratio:1.03;overflow:hidden;border-radius:24px}.wp-hero-picture img{height:100%}.wp-hero-picture>div{position:absolute;background:#ffffffed;bottom:16px;left:16px;right:16px;padding:18px;border-radius:15px;display:grid;gap:4px}.wp-hero-picture small{color:#536a7e}.wp-section{padding:clamp(45px,6vw,90px) 5vw}.wp-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:35px}.wp-heading h2{margin-top:12px}.wp-heading p{max-width:360px}.wp-problems,.wp-why{background:#e8eff5}.wp-triple{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.wp-triple article{overflow:hidden;background:#fff;border:1px solid #dce5eb;border-radius:18px}.wp-triple img{aspect-ratio:1.65}.wp-triple article>div{padding:23px;display:grid;gap:12px}.wp-triple b{font-size:15px}.wp-services{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.wp-services article{display:grid;grid-template-columns:39% 1fr auto;align-items:center;background:white;border:1px solid #dce5eb;border-radius:18px;overflow:hidden;min-width:0}.wp-services img{height:100%;min-height:190px}.wp-services article>div{display:grid;gap:10px;padding:20px}.wp-services strong{color:var(--blue)}.wp-services article>a{padding:12px;align-self:start;color:var(--blue);font-size:20px}.wp-estimate{background:#173852;color:white;display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center}.wp-estimate h2{margin:16px 0}.wp-estimate p{color:#cbdae5;max-width:480px}.wp-estimate img{width:160px;aspect-ratio:1;border-radius:15px;margin-top:25px}.wp-calc{background:white;border-radius:20px;color:var(--navy);padding:clamp(22px,4vw,44px);display:grid;gap:13px}.wp-calc label{font-size:15px;font-weight:700}.wp-calc select,.wp-calc input{font:inherit;width:100%;min-width:0;padding:12px;border-radius:8px;border:1px solid #c4d4e1;background:#f7fafc;color:var(--navy)}.wp-total{border-top:1px solid #dce5eb;padding:18px 0;display:grid;gap:5px}.wp-total strong{font-size:clamp(35px,4vw,54px);line-height:1;color:var(--blue);letter-spacing:-.04em}.wp-calc small{color:#657889}.wp-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:#e9f2fa;color:var(--blue);font-size:24px}.wp-process{display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:center}.wp-process>img{aspect-ratio:1.15;border-radius:22px}.wp-process h2{margin:14px 0 24px}.wp-process article{display:flex;gap:18px;border-top:1px solid #d0dce4;padding:20px 0}.wp-process article>span{color:var(--blue);font-weight:700}.wp-process article h3{margin-bottom:8px}.window-pro details{padding:20px 0;border-bottom:1px solid #d4dfe8}.window-pro summary{font-weight:700;cursor:pointer}.window-pro details p{margin-top:12px}.wp-contact{background:#132e46;color:white;padding:50px 5vw;display:flex;justify-content:space-between;align-items:center;gap:25px}.wp-contact h2{margin:15px 0}.wp-contact p{color:#d4e3ed}.wp-contact .wp-primary{background:white;color:var(--navy);border:0}.window-pro button:disabled{cursor:default}@media(max-width:850px){.wp-nav nav{display:none}.wp-hero,.wp-estimate,.wp-process{grid-template-columns:1fr}.wp-hero-picture{aspect-ratio:1.5}.wp-heading,.wp-contact{display:grid;justify-items:start}.wp-services{grid-template-columns:1fr}.wp-triple{grid-template-columns:1fr}.wp-triple img{aspect-ratio:1.8}}@media(max-width:450px){.wp-nav .wp-primary{font-size:12px;padding:10px}.wp-brand{font-size:17px;gap:7px}.wp-brand img{width:33px;height:33px}.wp-services article{grid-template-columns:1fr auto}.wp-services img{grid-column:1/-1;min-height:0;height:180px}.wp-services article>div{padding:18px}.wp-hero-picture{aspect-ratio:1.2}}</style>
