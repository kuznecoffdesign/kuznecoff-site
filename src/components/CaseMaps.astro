---
const {data,asset,back,website,business}=Astro.props;const isCeiling=business==='vysota';
const stories=isCeiling?['Что входит в смету?','Сохраняем высоту','Освещение по комнатам','Выбираем фактуру']:['Дует из окна?','Окна запотевают?','Заедает ручка?','Сначала диагностика'];
---
<div class="dw-demo-bar"><span>Яндекс Карты · Карточка</span><a href={back}>К кейсу Kuznecoff</a></div><header class="dw-platform-head"><strong><span>К</span> Деловая карточка</strong><a href={website}>Сайт {data.name}</a></header><main class="dw-platform-container"><div class="dw-maps-layout"><div class="dw-ui-card"><img class="dw-platform-cover" src={asset('brand-cover.webp')} alt={`Обложка ${data.name}`}/><div class="dw-platform-bio"><img src={asset('avatar.webp')} alt={`Логотип ${data.name}`}/><div><h1>{data.name}</h1><p>{data.tag}</p></div><a class="dw-ui-button" href={website+'#contact'}>Узнать стоимость</a></div><div class="dw-ui-tabs" role="tablist">{[['overview','Обзор'],['services','Услуги'],['offers','Предложения'],['photos','Фото']].map(([id,label],i)=><button type="button" role="tab" aria-selected={i===0} data-panel={id}>{label}</button>)}</div><div class="dw-ui-body dw-ui-panel" data-content="overview"><h2>О компании</h2><p>{data.description}</p><div class="dw-maps-stories custom-stories">{stories.map((title,i)=><a href={asset('post-'+i+'.webp')} target="_blank" rel="noopener"><img src={asset('post-'+i+'.webp')} alt={title}/><strong>{title}</strong></a>)}</div><h2>Популярные услуги</h2><div class="dw-ui-services">{data.services.slice(0,3).map(([name,desc,price],i)=><article class="dw-ui-service"><img src={asset('render-'+i+'.webp')} alt={name}/><div><h3>{name}</h3><p>{desc}</p><b>{price}</b></div></article>)}</div></div><div class="dw-ui-body dw-ui-panel" data-content="services" hidden><h2>Каталог услуг</h2><div class="dw-ui-services">{data.services.map(([name,desc,price],i)=><article class="dw-ui-service"><img src={asset('render-'+i+'.webp')} alt={name}/><div><h3>{name}</h3><p>{desc}</p><b>{price}</b></div></article>)}</div><p style="margin-top:14px;font-size:13px">Стоимость зависит от объёма работ.</p></div><div class="dw-ui-body dw-ui-panel" data-content="offers" hidden><h2>Предложения</h2><div class="dw-ui-services"><article class="dw-ui-service"><img src={asset('post-0.webp')} alt="Первичная консультация"/><div><h3>{isCeiling?'Подбор потолка и света':'Диагностика перед ремонтом'}</h3><p>Расскажите о задаче — обсудим варианты и предварительный бюджет.</p></div></article></div></div><div class="dw-ui-body dw-ui-panel" data-content="photos" hidden><h2>Фотоматериалы</h2><div class="dw-ui-photo-grid">{[0,1,2,3].map(i=><a href={asset('service-'+i+'.webp')} target="_blank" rel="noopener"><img src={asset('service-'+i+'.webp')} alt={data.services[i][0]}/></a>)}</div></div></div><aside><div class="dw-map-preview" aria-label="Схематичная карта без реального местоположения"><div class="dw-map-pin"><b>{data.name}</b>Местоположение не задано<br/><small>Схема карты</small></div></div><div class="dw-ui-card dw-ui-body" style="margin-top:20px"><h2>Карточка подготовлена</h2><p>Описание, каталог услуг, предложения, истории и фотографии в едином стиле.</p><img src={asset('post-3.webp')} alt="Материалы карточки" style="display:block;width:100%;margin-top:18px;border-radius:12px"/></div></aside></div></main>
<script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-panel]');const panels=document.querySelectorAll<HTMLElement>('[data-content]');buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.setAttribute('aria-selected',String(b===button)));panels.forEach(p=>p.hidden=p.dataset.content!==button.dataset.panel)}));</script>
<style is:global>.custom-stories{grid-template-columns:repeat(4,minmax(0,1fr))!important}.custom-stories a{position:relative;overflow:hidden;border-radius:12px;aspect-ratio: .67;background:#123}.custom-stories a img{width:100%;height:100%;object-fit:cover}.custom-stories a:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 35%,#000b)}.custom-stories strong{position:absolute;z-index:1;bottom:10px;left:10px;right:10px;font-size:clamp(11px,1.2vw,16px);line-height:1.15;color:#fff}@media(max-width:600px){.custom-stories{grid-template-columns:repeat(2,minmax(0,1fr))!important}}</style>
