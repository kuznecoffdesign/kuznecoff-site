---
import Icon from './MarketingIcon.astro';
const {part,base}=Astro.props;
const platform=[
 ['map','Карты','Вас находят и сравнивают','Каталог, цены, фотографии и ответы на вопросы помогают покупателю принять решение прямо в карточке.','maps','Найти'],
 ['social','ВКонтакте','Узнают больше и убеждаются','Обложка, меню, виджеты и публикации раскрывают пользу услуг и объясняют условия.','vk','Довериться'],
 ['web','Сайт','Выбирают решение и условия','Предложение, преимущества, примеры, стоимость и удобный переход к общению.','','Выбрать']
];
const methods=[
 ['01','Анализ бизнеса','Изучаю, что видит покупатель, сравниваю предложения конкурентов и определяю, каких аргументов не хватает.','map'],
 ['02','Смыслы и тексты','Формулирую оффер, раскрываю пользу услуг, условия и ответы на вопросы на языке клиента.','social'],
 ['03','Визуальная система','Создаю дизайн под нишу: сайт, обложки, меню, каталог, публикации и визуалы карт.','web'],
 ['04','Готовые материалы','Передаю согласованный комплект и помогаю разместить его на площадках в рамках проекта.','check']
];
---
{part==='pain' && <section class="section light sales-pain"><div class="sales-heading"><div><span class="sales-eyebrow">01 / Точка выбора</span><h2>Клиент сначала видит ваш бизнес <em>в интернете</em></h2></div><p>Он открывает несколько карточек, сравнивает фотографии, услуги и цены. Если не хватает ответов, у конкурента появляется ещё одна причина оказаться удобнее для выбора.</p></div><div class="sales-pain-grid">{[
 ['map','На картах','Вас трудно сравнить','Неполный каталог, старые фотографии или непонятная цена заставляют искать дальше.'],
 ['social','ВКонтакте','Неясно, за что платить','Красивая шапка и новости сами по себе не объясняют результат, условия и выбор услуги.'],
 ['web','На сайте','Не доходит до разговора','Общие обещания, мало примеров и непонятный следующий шаг усложняют обращение.']
].map(([icon,place,h,p])=><article><div class="pain-preview"><div class="preview-top"><i></i><i></i><i></i><small>{place}</small></div><div class="preview-body"><div class="sales-icon"><Icon name={icon}/></div><div class="preview-lines"><i></i><i></i><i></i></div><span class="preview-question">?</span></div></div><div class="pain-copy"><span>{place}</span><h3>{h}</h3><p>{p}</p></div></article>)}</div><div class="sales-note"><span class="sales-icon"><Icon name="check"/></span><p>Не нужно менять всё подряд. Сначала найдём, где вашему бизнесу не хватает аргументов.</p><a href="#audit">Как это выяснить →</a></div></section>}
{part==='system' && <section class="section sales-system"><div class="sales-heading"><div><span class="sales-eyebrow">03 / Система</span><h2>У каждой площадки <em>своя задача</em></h2></div><p>Клиент может начать с сайта, ВК или карт. Важно, чтобы в каждой точке он находил нужную информацию и понимал, что делать дальше.</p></div><div class="sales-system-grid">{platform.map(([icon,name,h,p,path,verb],i)=><article><div class="system-card-top"><span class="sales-icon"><Icon name={icon}/></span><span>0{i+1} / {verb}</span></div><img src={base+'/images/cases/vysota/demo-'+[1,2,0][i]+'.webp'} alt="" loading="lazy"/><div class="system-copy"><small>{name}</small><h3>{h}</h3><p>{p}</p><a href={base+'/demo/vysota/'+(path?path+'/':'')}>Посмотреть пример →</a></div></article>)}</div><div class="system-banner"><h3>Одна сильная мысль на всех площадках.</h3><p>За что клиент платит, почему вам можно довериться и как обратиться.</p></div></section>}
{part==='method' && <section class="section light sales-method" id="method"><div class="sales-heading"><div><span class="sales-eyebrow">04 / Подход</span><h2>Сначала разбираюсь, <em>за что у вас покупают</em></h2></div><p>Затем превращаю это в понятное предложение, тексты и визуальную систему. Дизайн помогает донести смысл, а не заменяет его.</p></div><div class="method-layout"><div class="method-list">{methods.map(([n,title,p,icon])=><article><span class="sales-icon"><Icon name={icon}/></span><div><small>{n}</small><h3>{title}</h3><p>{p}</p></div></article>)}</div><div class="method-example"><span class="sales-eyebrow">Пример / Тепло дома</span><div class="method-example-copy"><small>Задача покупателя</small><h3>Дует из окна.<br/>Нужно менять или ремонтировать?</h3><div class="method-arrow">↓</div><small>Смысл для коммуникации</small><strong>Сначала выясним причину — затем подберём решение.</strong></div><img src={base+'/images/cases/window-service/art-cover.webp'} alt="Обложка сообщества Тепло дома" loading="lazy"/><a href={base+'/work/window-service/'}>Смотреть решение в кейсе →</a></div></div></section>}
{part==='audit' && <section class="section sales-audit" id="audit"><div class="audit-card"><div class="audit-image"><img src={base+'/images/audit-render.webp'} alt="Объёмная иллюстрация анализа сайта" loading="lazy"/></div><div class="audit-content"><span class="sales-eyebrow">05 / Первый шаг</span><h2>Не знаете, с чего начать?</h2><p>Пришлите ссылку на сайт, карты или ВКонтакте. Посмотрю, какая информация уже работает и чего не хватает.</p><div class="audit-list">{['Замечания по оформлению и содержанию','Конкретные идеи для улучшений','Приоритет: с какой площадки начать'].map(s=><div><Icon name="check"/><span>{s}</span></div>)}</div><a class="button" href="#contact">Получить бесплатный разбор</a><small>Без обязательств заказывать работу.</small></div></div></section>}
<style>
.sales-heading{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,.65fr);gap:clamp(20px,5vw,80px);align-items:end;margin-bottom:40px}.sales-heading h2{font-size:clamp(36px,4.9vw,73px);line-height:1.03;letter-spacing:-.058em;margin:12px 0 0;font-weight:500}.sales-heading h2 em{font-style:normal;color:#777;display:block}.sales-heading>p{font-size:clamp(17px,1.45vw,21px);line-height:1.55;color:#666;max-width:43ch;margin:0}.sales-eyebrow{font-size:12px;letter-spacing:.1em;font-weight:600;text-transform:uppercase;color:#777}.sales-pain-grid,.sales-system-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.sales-pain-grid article{border:1px solid #d8d8d4;border-radius:24px;overflow:hidden;background:#fafaf8}.pain-preview{padding:18px;background:linear-gradient(135deg,#e3e3df,#f4f4f1)}.preview-top{display:flex;align-items:center;gap:5px;padding:10px 12px;background:#fff;border-radius:12px 12px 0 0}.preview-top i{width:6px;height:6px;background:#bbb;border-radius:50%}.preview-top small{margin-left:auto;font-size:11px;color:#777}.preview-body{display:flex;align-items:center;gap:13px;background:#fff;padding:18px 12px;border-top:1px solid #eee;border-radius:0 0 12px 12px}.sales-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:#e9e9e6;color:#333;flex:none}.sales-icon svg{width:25px;height:25px}.preview-lines{display:grid;gap:6px;flex:1}.preview-lines i{height:7px;border-radius:5px;background:#e8e8e5}.preview-lines i:nth-child(2){width:78%}.preview-lines i:nth-child(3){width:50%}.preview-question{font-weight:600;font-size:27px;color:#777}.pain-copy{padding:clamp(20px,2.4vw,32px)}.pain-copy>span,.system-copy small{font-size:13px;color:#777;font-weight:600}.pain-copy h3,.system-copy h3{font-size:clamp(23px,2.3vw,33px);letter-spacing:-.04em;line-height:1.1;margin:10px 0}.pain-copy p,.system-copy p{font-size:16px;line-height:1.55;color:#666;margin:0}.sales-note{display:flex;align-items:center;gap:20px;border:1px solid #d9d9d4;border-radius:20px;padding:20px 24px;margin-top:20px}.sales-note p{flex:1;font-size:17px;line-height:1.4;margin:0}.sales-note a,.system-copy a,.method-example a{font-size:15px;font-weight:600;text-decoration:underline;text-underline-offset:4px}.sales-system{background:#121212;color:#f5f5f2}.sales-system .sales-heading>p{color:#b4b4b0}.sales-system-grid article{border:1px solid #393939;background:#202020;border-radius:24px;overflow:hidden}.system-card-top{padding:18px;display:flex;justify-content:space-between;align-items:center;color:#aaa;font-size:13px}.system-card-top .sales-icon{background:#343434;color:#eee}.sales-system-grid img{display:block;width:calc(100% - 36px);margin:auto;aspect-ratio:1.5;object-fit:contain;background:#242424;border-radius:12px}.system-copy{padding:23px}.system-copy small,.system-copy p{color:#b5b5b0}.system-copy a{display:inline-block;margin-top:18px;color:#eee}.system-banner{display:flex;align-items:center;justify-content:space-between;gap:28px;border-top:1px solid #3c3c3c;margin-top:32px;padding-top:24px}.system-banner h3{font-size:clamp(23px,3vw,40px);letter-spacing:-.04em;line-height:1.1;font-weight:500;max-width:26ch}.system-banner p{font-size:17px;line-height:1.5;color:#aaa;max-width:34ch}.method-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.95fr);gap:22px;align-items:stretch}.method-list{display:grid;gap:12px}.method-list article{display:flex;align-items:flex-start;gap:18px;padding:23px;background:#fafaf8;border:1px solid #d9d9d4;border-radius:20px}.method-list small,.method-example small{font-size:12px;color:#777;text-transform:uppercase;letter-spacing:.08em}.method-list h3{font-size:23px;letter-spacing:-.04em;margin:4px 0 8px}.method-list p{font-size:16px;line-height:1.5;color:#666;margin:0}.method-example{background:#e5e5e0;border-radius:24px;padding:clamp(24px,3vw,40px);display:flex;flex-direction:column;gap:24px;justify-content:space-between;min-width:0}.method-example-copy{background:#f7f7f4;padding:24px;border-radius:16px}.method-example h3{font-size:clamp(23px,3vw,38px);line-height:1.1;letter-spacing:-.04em;margin:8px 0 0;font-weight:500}.method-example strong{display:block;font-size:clamp(19px,2vw,27px);line-height:1.2;letter-spacing:-.03em;margin-top:8px}.method-arrow{font-size:28px;margin:12px 0;color:#777}.method-example img{width:100%;border-radius:12px;display:block}.sales-audit{background:#121212}.audit-card{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);background:#f2f2ef;color:#151515;border-radius:28px;overflow:hidden;align-items:center}.audit-image{min-width:0;padding:18px}.audit-image img{width:100%;display:block;border-radius:18px;aspect-ratio:1;object-fit:contain}.audit-content{padding:clamp(25px,4vw,58px)}.audit-content h2{font-size:clamp(34px,4.6vw,64px);line-height:1.03;letter-spacing:-.055em;margin:12px 0 18px;font-weight:500}.audit-content>p{font-size:18px;line-height:1.5;color:#626262}.audit-list{display:grid;gap:10px;margin:25px 0}.audit-list>div{display:flex;gap:12px;align-items:center;font-size:16px}.audit-list svg{width:23px;height:23px;flex:none}.audit-content .button{background:#161616;color:white;display:inline-flex;margin:0}.audit-content>small{display:block;margin-top:14px;color:#666;font-size:13px}.sales-audit .audit-content .button:hover{background:#444}
@media(max-width:850px){.sales-heading,.method-layout,.audit-card{grid-template-columns:1fr}.sales-heading{gap:18px;margin-bottom:28px}.sales-pain-grid,.sales-system-grid{grid-template-columns:1fr}.sales-system-grid img{aspect-ratio:2;max-height:260px}.sales-note,.system-banner{align-items:flex-start;flex-wrap:wrap}.sales-note p{flex-basis:70%}.audit-image{max-width:420px;margin:auto}.audit-content{padding-top:12px}.method-example{gap:18px}}@media(max-width:450px){.sales-note{padding:16px;gap:12px}.sales-note a{margin-left:0}.method-list article{padding:17px;gap:12px}.method-list h3{font-size:21px}.method-example{padding:18px}.method-example-copy{padding:17px}.audit-content>p{font-size:16px}.audit-content .button{width:100%;justify-content:center;text-align:center}.audit-image{padding:12px}.audit-card{border-radius:20px}}
</style>
