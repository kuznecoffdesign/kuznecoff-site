---
const {data,asset,back,website,business}=Astro.props;const ceiling=business==='vysota';const posts=data.posts.slice(0,4);
---
<header class="vk-head vk-wrap"><a href={back} class="vk-toplink">kuznecoff.design</a><a class="vk-toplink" href={website}>Сайт {data.name}</a></header><main class="vk-wrap"><section class="vk-intro"><p class="vk-kicker">{data.name} / ВКонтакте</p><h1>Оформление<br/>сообщества</h1><p>Единая визуальная система, каталог услуг и полезный контент.</p></section><section class="vk-section" id="cover"><div class="vk-section-head"><span>01 / Айдентика</span><h2>Обложка и аватар</h2></div><a class="vk-art vk-cover" href={asset('art-cover.webp')} target="_blank" rel="noopener"><img src={asset('art-cover.webp')} alt={`Обложка ${data.name}`}/></a><div class="vk-brand-info"><a class="vk-art vk-avatar" href={asset('art-avatar.webp')} target="_blank" rel="noopener"><img src={asset('art-avatar.webp')} alt={`Логотип ${data.name}`}/></a><div><h3>{ceiling?'Потолок, который завершает интерьер':'В доме должно быть тепло'}</h3><p>{data.description}</p></div></div><nav class="case-vk-menu" aria-label="Меню сообщества"><a href="#products">Услуги и цены</a><a href="#posts">Полезные советы</a><a href={website+'#estimate'}>Рассчитать стоимость</a></nav></section><section class="vk-section" id="pinned"><div class="vk-section-head"><span>02 / Знакомство</span><h2>Закреплённая запись</h2></div><article class="vk-post"><div class="vk-post-copy"><h3>{ceiling?'Планируете ремонт? Начнём с потолка и света':'Дует из окна? Не спешите менять его'}</h3><p>{data.description}</p><p>{ceiling?'Пришлите план комнаты и пожелания по свету. Обсудим варианты полотна, профиля и освещения, чтобы смета была понятной до начала работ.':'Пришлите фото окна, опишите проблему и когда она появилась. Обсудим, нужна ли регулировка, замена уплотнения или ремонт фурнитуры.'}</p></div></article></section><section class="vk-section" id="products"><div class="vk-section-head"><span>03 / Каталог</span><h2>Карточки услуг</h2><p>Единая серия 3D-рендеров. Описание и стоимость — отдельно от изображения.</p></div><div class="vk-products">{data.services.map(([name,desc,price],i)=><article><a class="vk-art" href={asset('art-render-'+i+'.webp')} target="_blank" rel="noopener"><img src={asset('art-render-'+i+'.webp')} alt={name} loading="lazy"/></a><h3>{name}</h3><p>{desc}</p><strong>{price}</strong></article>)}</div></section><section class="vk-section" id="posts"><div class="vk-section-head"><span>04 / Контент</span><h2>Публикации</h2><p>Практические вопросы, аргументы и решения. От узнавания проблемы до обращения.</p></div><div class="vk-posts">{posts.map(([title,body],i)=><article class="vk-post"><a class="vk-art campaign-post" href={asset('art-post-'+i+'.webp')} target="_blank" rel="noopener"><img src={asset('art-post-'+i+'.webp')} alt={title} loading="lazy"/></a><div class="vk-post-copy"><h3>{title}</h3>{body.split('\n\n').map(p=><p>{p}</p>)}</div></article>)}</div>{data.posts.slice(4).map(([title,body])=><article class="vk-post extra-post"><div class="vk-post-copy"><h3>{title}</h3>{body.split('\n\n').map(p=><p>{p}</p>)}</div></article>)}</section></main><footer class="vk-footer vk-wrap"><div><strong>{data.name}</strong><p>Оформление сообщества ВКонтакте</p></div><a class="vk-back" href={back}>Вернуться к кейсу</a></footer>
<style is:global>.editorial-post{position:relative;aspect-ratio:1;overflow:hidden}.editorial-post img{width:100%;height:100%;object-fit:cover}.editorial-post:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#121915e8,transparent 75%)}.editorial-post>div{position:absolute;z-index:1;inset:auto 6% 7%;display:grid;gap:13px;color:white}.editorial-post small{font-size:12px;text-transform:uppercase;letter-spacing:.12em}.editorial-post strong{font-size:clamp(25px,3.5vw,52px);line-height:1.05;letter-spacing:-.04em}.extra-post{margin-top:24px}.vk-showcase.vysota{background:#1e261e;--panel:#273127;--line:#465045}.vk-showcase.vysota .vk-section-head>span{color:#c6ac7e}.vk-showcase.vysota .editorial-post strong{font-family:Georgia,serif;font-weight:400}.vk-showcase.window-service{background:#12202f;--panel:#1a2c40;--line:#344b62}.vk-showcase.window-service .vk-section-head>span{color:#9dc9ee}.vk-showcase.window-service .editorial-post:after{background:linear-gradient(0deg,#102b49ee,transparent 75%)}.vk-showcase .vk-wrap{max-width:1360px}.vk-showcase .vk-products img{aspect-ratio:1;object-fit:cover}.vk-showcase .vk-cover img{aspect-ratio:3/1;object-fit:cover}.case-vk-menu{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:28px}.case-vk-menu a{padding:18px 20px;border:1px solid var(--line);border-radius:14px;background:var(--panel);font-size:16px;font-weight:600}.case-vk-menu a:hover{filter:brightness(1.15)}.campaign-post img{aspect-ratio:1;object-fit:contain}@media(max-width:600px){.case-vk-menu{grid-template-columns:1fr}.case-vk-menu a{padding:13px 15px}}</style>
