---
const {data,business,asset}=Astro.props;const ceiling=business==='vysota';
const problems=ceiling?[['Смета без сюрпризов','Согласуем полотно, профиль, свет и монтаж до начала работ.'],['Сохранить высоту','Подбираем профиль и светильники с учётом высоты помещения.'],['Освещение под интерьер','Продумываем световые сценарии до установки потолка.']]:[['Дует из окна','Проверим прилегание створки и состояние уплотнения.'],['Ручка заедает','Разберёмся, требуется ли регулировка или ремонт механизма.'],['Запотевают стёкла','Проверим, где появляется влага: на поверхности или внутри стеклопакета.']];
const photos=ceiling?['bedroom.webp','hall.webp','kitchen.webp','cover.webp']:['service-0.webp','service-1.webp','service-2.webp','service-3.webp'];
const faq=ceiling?[['Что входит в стоимость?','Полотно, профиль, монтаж и выбранные элементы освещения рассчитываются отдельно. Итог зависит от помещения и согласованной комплектации.'],['Сколько высоты потеряет комната?','Это зависит от перепада перекрытия, профиля и светильников. Точные размеры определяют при замере.'],['Когда делать потолок?','Порядок работ зависит от отделки, мебели и коммуникаций. Обсудите последовательность с мастером заранее.']]:data.faq;
---
<div class:list={['business-site',ceiling?'ceiling-site':'window-site']}><header class="business-nav"><a class="business-brand" href="#top"><span>{ceiling?'В':'ТД'}</span>{data.name}</a><nav><a href="#services">Услуги</a><a href="#details">Как работаем</a><a href="#faq">Вопросы</a></nav><a class="business-button" href="#contact">{ceiling?'Обсудить потолок':'Обсудить ремонт'}</a></header><main id="top"><section class="business-hero"><div class="business-hero-copy"><p class="business-kicker">{data.tag}</p><h1>{ceiling?'Потолок, который завершает интерьер':'Дует из окна? Не спешите менять его'}</h1><p>{data.description}</p><a class="business-button" href="#services">{ceiling?'Выбрать решение':'Посмотреть услуги'}</a><div class="business-badges"><span>✓ Понятная смета</span><span>✓ Подбор под задачу</span></div></div><div class="business-hero-image"><img src={asset(ceiling?'cover.webp':'technician.webp')} alt={ceiling?'Гостиная с современным потолком и светом':'Мастер регулирует окно'}/><div class="image-caption"><small>{ceiling?'Интерьер и свет':'Диагностика и ремонт'}</small><strong>{ceiling?'Свет, который подходит вашему дому':'Сохраняем то, что можно отремонтировать'}</strong></div></div></section><section class="business-section business-problems"><div class="business-heading"><h2>{ceiling?'Что важно до замера':'Что беспокоит ваше окно?'}</h2><p>{ceiling?'Решения лучше принимать до монтажа, а не переделывать после.':'Один симптом может иметь несколько причин. Начнём с диагностики.'}</p></div><div class="business-grid">{problems.map(([title,desc],i)=><article><span class="business-number">0{i+1}</span><h3>{title}</h3><p>{desc}</p></article>)}</div></section><section class="business-section" id="services"><div class="business-heading"><h2>{ceiling?'Решения для вашего интерьера':'Услуги и стоимость'}</h2><p>Понятные ориентиры. Итоговая смета — после оценки задачи.</p></div><div class="business-services">{data.services.map(([title,desc,price],i)=><article><img src={asset(photos[i])} alt="Иллюстрация услуги" loading="lazy"/><div><h3>{title}</h3><p>{desc}</p><strong>{price}</strong></div></article>)}</div></section><section class="business-section business-details" id="details"><img src={asset(ceiling?'hall.webp':'cover.webp')} alt={ceiling?'Потолок с контурной подсветкой':'Светлая комната с окнами'} loading="lazy"/><div><p class="business-kicker">Без лишних работ</p><h2>{ceiling?'От идеи до готового потолка':'Сначала причина, потом ремонт'}</h2>{(ceiling?[['Обсуждение','Уточняем размеры, пожелания по свету и отделке.'],['Замер и смета','Проверяем помещение и согласуем состав работ.'],['Монтаж','Выполняем согласованные работы и проверяем результат.']]:[['Опишите симптом','Фото и описание помогут понять, с чего начать.'],['Диагностика','Проверяем состояние створки, уплотнения и фурнитуры.'],['Решение','Согласуем необходимые работы и проверяем окно после ремонта.']]).map(([title,desc],i)=><div class="detail-step"><span>0{i+1}</span><div><h3>{title}</h3><p>{desc}</p></div></div>)}</div></section><section class="business-section" id="faq"><div class="business-heading"><h2>Вопросы перед началом</h2><p>Всё важное, чтобы принять решение спокойно.</p></div>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section class="business-contact" id="contact"><div><p class="business-kicker">Начнём с вашей задачи</p><h2>{ceiling?'Планируете ремонт?':'Расскажите, что случилось с окном'}</h2><p>{ceiling?'Пришлите план комнаты и пожелания по свету.':'Пришлите фото окна и опишите проблему.'}</p></div><button class="business-button" disabled>Написать в мессенджер</button></section></main></div>
