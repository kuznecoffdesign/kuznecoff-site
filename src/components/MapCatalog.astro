---
const {data,asset,back,website,business}=Astro.props;const ceiling=business==='vysota';const stories=ceiling?['Смета без сюрпризов','Сохраняем высоту','Свет по зонам','Выбираем фактуру']:['Сквозняк из окна','Конденсат на стекле','Заедает ручка','Когда нужен ремонт'];const benefits=ceiling?['Смета до монтажа','Подбор освещения','Варианты под бюджет']:['Диагностика причины','Ремонт вместо замены','Согласованная смета'];
---
<div class="dw-demo-bar"><span>Яндекс Карты · Оформление карточки</span><a href={back}>К кейсу Kuznecoff</a></div><header class="dw-platform-head"><strong><span>К</span> Карточка компании</strong><a href={website}>Сайт {data.name}</a></header><main class:list={['map-redesign',business]}><div class="map-intro"><div><p>Оформление карточки</p><h1>{data.name}</h1><p>{data.tag} — визуальная система, каталог услуг и истории.</p></div><span>Демонстрационный проект</span></div><div class="map-frame"><div class="map-main"><img class="map-banner" src={asset('brand-cover.webp')} alt={`Обложка ${data.name}`}/><div class="map-profile"><img src={asset('avatar.webp')} alt="Логотип"/><div><h2>{data.name}</h2><p>{data.tag}</p></div><a class="map-primary" href={website+'#estimate'}>Рассчитать стоимость</a></div><div class="map-tags">{benefits.map(t=><span>✓ {t}</span>)}</div><div class="map-tabs" role="tablist">{[['overview','Обзор'],['services','Услуги'],['offers','Предложения'],['photos','Фото']].map(([id,label],i)=><button type="button" role="tab" aria-selected={i===0} data-panel={id}>{label}</button>)}</div><section class="map-panel" data-content="overview"><h2>О компании</h2><p>{data.description}</p><h2>Истории</h2><div class="map-stories">{stories.map((title,i)=><article><img src={asset('post-'+i+'.webp')} alt=""/><strong>{title}</strong><small>{data.name}</small></article>)}</div><h2>Популярные услуги</h2><div class="map-catalog">{data.services.map(([name,desc,price],i)=><article><img src={asset('render-'+i+'.webp')} alt={name}/><div><h3>{name}</h3><p>{desc}</p><b>{price}</b></div></article>)}</div></section><section class="map-panel" data-content="services" hidden><h2>Каталог услуг</h2><div class="map-catalog">{data.services.map(([name,desc,price],i)=><article><img src={asset('render-'+i+'.webp')} alt={name}/><div><h3>{name}</h3><p>{desc}</p><b>{price}</b></div></article>)}</div><p>Цены ориентировочные. Итоговая смета после оценки задачи.</p></section><section class="map-panel" data-content="offers" hidden><h2>Предложения</h2><div class="map-offer"><img src={asset('post-3.webp')} alt="Иллюстрация предложения"/><div><h3>{ceiling?'Подберём потолок и свет':'Начнём с диагностики'}</h3><p>Расскажите о задаче — обсудим варианты и предварительный бюджет.</p><a class="map-primary" href={website+'#estimate'}>Посмотреть расчёт</a></div></div></section><section class="map-panel" data-content="photos" hidden><h2>Фотографии услуг</h2><div class="map-photos">{data.services.map(([name],i)=><figure><img src={asset('service-'+i+'.webp')} alt={name}/><figcaption>{name}</figcaption></figure>)}</div></section></div><aside><article class="map-side"><h3>Фотографии</h3><div class="map-photos">{[0,1,2,3].map(i=><img src={asset('service-'+i+'.webp')} alt={data.services[i][0]}/>)}</div><button type="button" class="map-secondary" data-go="photos">Все фотографии</button></article><article class="map-side"><h3>Как начать</h3><p>{ceiling?'Пришлите план помещения и пожелания по освещению.':'Пришлите фото окна и расскажите, что беспокоит.'}</p><a class="map-primary" href={website+'#estimate'}>Узнать стоимость</a></article><article class="map-side"><h3>Местоположение</h3><div class="dw-map-preview"><div class="dw-map-pin"><b>{data.name}</b><small>Схема карты</small></div></div><p>Адрес не задан — демонстрационный макет.</p></article></aside></div></main>
<script>const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-panel]')],panels=[...document.querySelectorAll<HTMLElement>('[data-content]')];function choose(id:string){tabs.forEach(b=>b.setAttribute('aria-selected',String(b.dataset.panel===id)));panels.forEach(p=>p.hidden=p.dataset.content!==id)}tabs.forEach(b=>b.addEventListener('click',()=>choose(b.dataset.panel||'overview')));document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach(b=>b.addEventListener('click',()=>{choose(b.dataset.go||'photos');document.querySelector('.map-tabs')?.scrollIntoView({behavior:'smooth',block:'start'})}));</script>
<style is:global>.map-redesign{--map-brand:#235d91;max-width:1320px;width:calc(100% - 40px);margin:32px auto 70px;color:#222;font:16px/1.5 Arial,sans-serif}.map-redesign.vysota{--map-brand:#535f44}.map-redesign *{box-sizing:border-box}.map-redesign h1,.map-redesign h2,.map-redesign h3,.map-redesign p{margin:0}.map-redesign img{display:block;width:100%;object-fit:cover}.map-intro{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px;gap:20px}.map-intro h1{font-size:clamp(36px,5vw,60px);letter-spacing:-.05em;line-height:1.05;margin:8px 0}.map-intro p{color:#67727c}.map-intro>span{font-size:13px;color:#71808c}.map-frame{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,1fr);gap:18px;align-items:start}.map-main,.map-side{background:white;border:1px solid #e0e5e8;border-radius:18px;overflow:hidden}.map-redesign .map-banner{aspect-ratio:3/1;object-fit:contain;background:var(--map-brand)}.map-profile{display:flex;align-items:center;gap:15px;padding:22px}.map-profile img{width:60px;height:60px;border-radius:12px}.map-profile h2{font-size:26px}.map-profile p{font-size:15px;color:#64727d}.map-primary,.map-secondary{display:inline-flex;justify-content:center;border:0;padding:12px 17px;border-radius:10px;font:600 14px Arial,sans-serif;cursor:pointer}.map-primary{background:var(--map-brand);color:#fff}.map-secondary{background:#edf0f3;color:#334552}.map-profile .map-primary{margin-left:auto;text-align:center}.map-tags{display:flex;flex-wrap:wrap;gap:7px;padding:0 22px 18px}.map-tags span{background:#edf2f5;color:#465561;padding:7px 11px;border-radius:30px;font-size:13px}.map-tabs{display:flex;gap:4px;flex-wrap:wrap;padding:0 20px;border-block:1px solid #e5e8ea}.map-tabs button{padding:15px 12px;border:0;background:none;color:#697581;font-weight:600;border-bottom:3px solid transparent}.map-tabs button[aria-selected=true]{color:#23282c;border-color:var(--map-brand)}.map-panel{padding:22px;display:grid;gap:16px}.map-panel[hidden]{display:none!important}.map-panel h2{font-size:24px;letter-spacing:-.035em;margin-top:8px}.map-panel p,.map-side p{color:#64727d;font-size:15px;line-height:1.5}.map-stories{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.map-stories article{position:relative;aspect-ratio:.67;overflow:hidden;border-radius:12px;background:var(--map-brand);color:white}.map-stories img{height:100%}.map-stories article:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 25%,#101b25e8)}.map-stories strong,.map-stories small{position:absolute;z-index:1;left:10px;right:10px;bottom:27px;line-height:1.1;font-size:clamp(13px,1.4vw,20px)}.map-stories small{bottom:10px;font-size:9px;text-transform:uppercase;letter-spacing:.08em}.map-catalog{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.map-catalog article{border-radius:13px;border:1px solid #dfe5e8;overflow:hidden;display:flex;flex-direction:column}.map-catalog img{aspect-ratio:1;object-fit:contain}.map-catalog article>div{padding:15px;display:grid;gap:7px;flex:1}.map-catalog h3{font-size:19px;line-height:1.14}.map-catalog b{color:var(--map-brand);margin-top:auto}.map-side{padding:18px;display:grid;gap:14px;margin-bottom:15px}.map-side h3{font-size:21px}.map-photos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.map-photos img{aspect-ratio:1.35;border-radius:9px}.map-photos figure{margin:0}.map-photos figcaption{font-size:13px;color:#64727d;padding-top:5px}.map-redesign .dw-map-preview{min-height:170px}.map-offer{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center}.map-offer img{border-radius:13px}.map-offer h3{font-size:24px;margin-bottom:10px}.map-offer .map-primary{margin-top:14px}@media(max-width:850px){.map-frame{grid-template-columns:1fr}.map-intro{display:block}.map-intro>span{display:block;margin-top:10px}}@media(max-width:500px){.map-redesign{width:calc(100% - 16px);margin-top:18px}.map-profile{flex-wrap:wrap;padding:15px}.map-profile .map-primary{margin:0;width:100%}.map-panel{padding:14px}.map-tags{padding:0 14px 15px}.map-tabs{padding:0 8px}.map-tabs button{font-size:13px;padding:12px 7px}.map-stories{grid-template-columns:repeat(2,minmax(0,1fr))}.map-catalog h3{font-size:17px}.map-catalog article>div{padding:10px}.map-offer{grid-template-columns:1fr}.map-catalog p{font-size:13px}}</style>
