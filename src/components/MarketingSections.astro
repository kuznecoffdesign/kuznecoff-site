---
import Icon from './MarketingIcon.astro';
const pain=[['map','На картах','Клиент сравнивает вас с соседними компаниями.','Неясные услуги, устаревшие фото и скрытый прайс мешают сделать выбор.'],['social','В соцсетях','Клиент ищет ответы перед покупкой.','Редкие публикации не раскрывают ценность услуг и не создают доверия.'],['web','На сайте','Клиент хочет понять условия и цену.','Сложная структура и общие обещания заставляют искать дальше.']];
const system=[['map','01','Найти','Карты','Понятная карточка, услуги, цены и фотографии помогают выбрать вас среди конкурентов.'],['social','02','Довериться','ВКонтакте','Полезный контент, отзывы при наличии и ответы на вопросы помогают решиться на обращение.'],['web','03','Выбрать','Сайт','Показываем преимущества, варианты, стоимость и удобный способ связаться.']];
---
<section class="section light marketing-pains"><div class="section-head"><h2 data-reveal>Клиенты находят вас<span>Но выбирают ли?</span></h2><p class="lead" data-reveal>Даже хороший бизнес может проигрывать конкурентам, если его сложно понять в интернете.</p></div><div class="marketing-grid">{pain.map(([icon,title,lead,detail],i)=><article data-reveal style={`--delay:${i*100}ms`}><div class="marketing-icon"><Icon name={icon}/></div><h3>{title}</h3><strong>{lead}</strong><p>{detail}</p></article>)}</div></section>
<section class="section marketing-system"><div class="section-head"><h2 data-reveal>Не три площадки<span>Одна система</span></h2><p class="lead" data-reveal>Каждая площадка решает свою задачу на пути от поиска до обращения.</p></div><div class="marketing-grid">{system.map(([icon,n,title,platform,detail],i)=><article data-reveal style={`--delay:${i*100}ms`}><div class="marketing-top"><div class="marketing-icon"><Icon name={icon}/></div><span>{n}</span></div><small>{platform}</small><h3>{title}</h3><p>{detail}</p></article>)}</div><div class="marketing-bottom" data-reveal><p>От первого знакомства до диалога с вашим бизнесом.</p><a class="button" href="#contact">Разобрать мой бизнес</a></div></section>
