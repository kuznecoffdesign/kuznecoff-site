---
const {data,asset,back,website,business}=Astro.props;
const ceiling=business==='vysota';
const detailing=business==='detail';
const contact=website+(detailing?'#estimate':'#contact');
const menus=[['Задать вопрос',contact],['Наши услуги','#products'],['Рассчитать стоимость',website+'#estimate']];
const widgets=detailing?[
 ['Вернём кузову блеск','Выбрать полировку','#products'],
 ['Защитим от сколов','Подобрать защиту','#products'],
 ['Обновим салон','Рассчитать уход',website+'#estimate']
]:ceiling?[
 ['Подберём потолок','Выбрать решение','#products'],
 ['Записаться на замер','Обсудить проект',website+'#contact'],
 ['Спланируем освещение','Посмотреть варианты','#products']
]:[
 ['Новые окна под ключ','Выбрать решение',website+'#choice'],
 ['Записаться на замер','Обсудить задачу',website+'#contact'],
 ['Ремонт и обслуживание','Посмотреть услуги','#products']
];
---
<header class="vk-head vk-wrap"><a href={back} class="vk-toplink">kuznecoff.design</a><a class="vk-toplink" href={website}>Сайт {data.name} →</a></header>
<main class:list={['vk-wrap','vk-premium', {ceiling,detailing}]}>
 <section class="premium-intro">
   <div><p class="vk-kicker">ВКОНТАКТЕ / {data.name}</p><h1>Сообщество,<br/>которому доверяют</h1></div>
   <div><p>{detailing?'Показываем качество ухода за автомобилем, объясняем разницу между услугами и помогаем выбрать подходящий комплекс.':ceiling?'Показываем эстетику готового интерьера и помогаем разобраться в деталях до замера.':'Помогаем клиенту разобраться в выборе окон, ремонте и стоимости ещё до обращения.'}</p><span>Обложки · меню · виджеты · контент</span></div>
 </section>
 <section class="portfolio-board" aria-label="Визуальная система сообщества">
   <div class="board-caption"><span>01 / Визуальная система</span><span>DESKTOP + MOBILE</span></div>
   <div class="community">
     <a class="community-cover" href={asset('art-cover.webp')} target="_blank" rel="noopener"><img src={asset('art-cover.webp')} alt={`Обложка ${data.name}`}/></a>
     <div class="community-profile"><img src={asset('art-avatar.webp')} alt="Аватар"/><div><strong>{data.name}</strong><p>{data.tag}</p></div><a href={contact}>Написать →</a></div>
   </div>
   <div class="board-lower">
     <div class="board-content">
       <div class="board-panel">
         <div class="panel-title"><h2>Меню сообщества</h2><span>03</span></div>
         <nav class="visual-menu" aria-label="Меню сообщества">{menus.map(([label,link],i)=><a href={link}><img src={asset('menu-'+i+'.webp')} alt="" loading="lazy"/><strong>{label}</strong></a>)}</nav>
       </div>
       <div class="board-panel">
         <div class="panel-title"><h2>Вертикальные виджеты</h2><span>03</span></div>
         <div class="visual-widgets">{widgets.map(([label,action,link],i)=><a href={link} class="widget"><div class="widget-art"><img src={asset('widget-'+i+'.webp')} alt="" loading="lazy"/><strong>{label}</strong><span>{action} →</span></div><p>{action}</p></a>)}</div>
       </div>
     </div>
     <aside class="phone-display"><div class="phone-label">Мобильная обложка</div><a class="phone phone-artwork" href={asset('mobile-cover.webp')} target="_blank" rel="noopener"><span class="phone-camera" aria-hidden="true"></span><img src={asset('mobile-cover.webp')} alt={`Вертикальная обложка ${data.name}`}/></a><p>Фирменная обложка в вертикальном формате.</p></aside>
   </div>
 </section>
 <section class="premium-rationale"><div><span>01</span><h3>Сразу понятно, что предлагают</h3><p>Обложка объясняет специализацию, а аватар закрепляет узнаваемость.</p></div><div><span>02</span><h3>Путь к нужному разделу</h3><p>Меню помогает быстро найти услуги, спросить совета или рассчитать бюджет.</p></div><div><span>03</span><h3>Следующий шаг без лишних поисков</h3><p>Виджеты выделяют конкретные поводы для обращения.</p></div></section>
 <section class="vk-section" id="products"><div class="vk-section-head"><span>02 / Каталог</span><h2>Услуги, которые легко сравнить</h2><p>Предметная графика показывает решение, а короткое описание объясняет его пользу.</p></div><div class="vk-products">{data.services.map(([name,desc,price],i)=><article><a class="vk-art" href={asset('art-render-'+i+'.webp')} target="_blank" rel="noopener"><img src={asset('art-render-'+i+'.webp')} alt={name} loading="lazy"/></a><h3>{name}</h3><p>{desc}</p><strong>{price}</strong></article>)}</div></section>
 <section class="vk-section" id="posts"><div class="vk-section-head"><span>03 / Контент</span><h2>Публикации, которые отвечают на вопросы</h2><p>Заголовок цепляет знакомой ситуацией, а текст помогает разобраться и сделать следующий шаг.</p></div><div class="vk-posts">{data.posts.slice(0,detailing?5:4).map(([name,body],i)=><article class="vk-post"><a class="vk-art" href={asset('art-post-'+i+'.webp')} target="_blank" rel="noopener"><img src={asset('art-post-'+i+'.webp')} alt={name} loading="lazy"/></a><div class="vk-post-copy"><h3>{name}</h3>{body.split('\n\n').map(p=><p>{p}</p>)}</div></article>)}</div></section>
 <slot />
</main>
<footer class="vk-footer vk-wrap"><div><strong>{data.name}</strong><p>Визуальная система ВКонтакте</p></div><a class="vk-back" href={back}>Вернуться к кейсу →</a></footer>
<style is:global>
.vk-showcase.window-service{background:#0b1726;--panel:#15263a;--line:#2b3c52}.vk-showcase.vysota{background:#232920;--panel:#30392c;--line:#465040}.vk-premium{--brand:#1264c5;--ink:#122c49;--surface:#edf4fc;--board:#dbe8f7}.vk-premium.ceiling{--brand:#806130;--ink:#30372b;--surface:#faf4e9;--board:#e7ddcc}.premium-intro{display:grid;grid-template-columns:1.4fr .6fr;align-items:end;gap:40px;padding:clamp(45px,6vw,90px) 0 42px}.premium-intro h1{font-size:clamp(44px,6.2vw,86px);font-weight:600;line-height:.99;letter-spacing:-.055em;margin-top:16px}.premium-intro>div:last-child p{font-size:19px;line-height:1.55;color:#d8dfe5;max-width:380px}.premium-intro>div:last-child span{font-size:12px;letter-spacing:.08em;display:block;margin-top:20px;color:#a8b7bf}.portfolio-board{background:radial-gradient(ellipse at 90% 72%,#ffffffa0,transparent 50%),var(--board);color:var(--ink);border-radius:24px;padding:clamp(16px,3.5vw,45px);overflow:hidden}.board-caption{display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;margin-bottom:20px}.community{border-radius:13px;overflow:hidden;background:var(--surface);box-shadow:0 15px 36px #00000014}.community-cover{display:block}.community-cover img{aspect-ratio:3/1;object-fit:contain}.community-profile{display:flex;align-items:center;gap:15px;padding:17px 22px;position:relative}.community-profile>img{width:78px;height:78px;border-radius:50%;border:4px solid var(--surface);margin-top:-42px;box-shadow:0 4px 15px #0002}.community-profile strong{font-size:23px;letter-spacing:-.025em}.community-profile p{font-size:13px;margin-top:4px;color:#586474}.community-profile>a{margin-left:auto;border-radius:8px;background:var(--brand);padding:11px 18px;color:white;font-weight:700;font-size:13px}.board-lower{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.37fr);gap:24px;align-items:start;margin-top:22px}.board-content{display:grid;gap:16px;min-width:0}.board-panel{background:var(--surface);border-radius:13px;padding:17px}.panel-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.panel-title h2{font-size:18px;letter-spacing:-.03em}.panel-title>span{font-size:12px;opacity:.6}.visual-menu,.visual-widgets{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.visual-menu a,.widget{min-width:0;text-align:center}.visual-menu img{aspect-ratio:1.83;object-fit:cover;border-radius:8px}.visual-menu strong,.widget>p{font-size:clamp(12px,1.2vw,15px);font-weight:700;display:block;line-height:1.2;margin-top:10px}.widget-art{position:relative;border-radius:9px;overflow:hidden;aspect-ratio:508/737;text-align:left}.widget-art img{height:100%;width:100%;object-fit:cover}.widget-art>strong{position:absolute;left:9%;right:9%;top:7%;font-size:clamp(12px,1.7vw,24px);font-weight:800;line-height:1;letter-spacing:-.045em;text-wrap:balance}.widget-art>span{position:absolute;left:9%;right:9%;bottom:6%;padding:9px 6px;background:var(--brand);color:white;border-radius:5px;font-size:clamp(9px,.9vw,13px);text-align:center;font-weight:700}.phone-display{align-self:center;text-align:center;min-width:0}.phone-label{font-size:13px;font-weight:700;margin-bottom:12px}.phone{position:relative;margin:auto;width:min(100%,305px);aspect-ratio:9/18.9;border:7px solid #252729;border-radius:clamp(24px,3vw,40px);box-shadow:12px 22px 35px #25334852,inset 0 0 0 1px #fff8;overflow:hidden;background:#222}.phone>img{width:100%;height:100%;object-fit:cover}.phone-camera{position:absolute;top:9px;left:50%;transform:translateX(-50%);width:32%;height:15px;border-radius:12px;background:#17191c;z-index:2}.phone-title{position:absolute;left:9%;right:9%;top:10%;text-align:left;display:grid;gap:7px}.phone-title small{font-size:clamp(10px,1vw,14px);font-weight:700;letter-spacing:.04em;text-transform:uppercase}.phone-title strong{font-size:clamp(18px,2.5vw,37px);line-height:.97;letter-spacing:-.055em;font-weight:800}.phone-title>span{font-size:clamp(8px,.9vw,12px);font-weight:700}.phone-profile{position:absolute;bottom:0;left:0;right:0;padding:24px 8px 14px;display:grid;justify-items:center;gap:7px;background:linear-gradient(transparent,#101820e8);color:white}.phone-profile img{width:42px;height:42px;border-radius:50%;border:2px solid white}.phone-profile b{font-size:14px}.phone-profile span{border-radius:6px;background:white;color:#13243a;font-size:11px;padding:8px 16px;font-weight:700}.phone-display>p{font-size:12px;line-height:1.5;margin:18px auto 0;max-width:240px;opacity:.8}.premium-rationale{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;padding:36px 0 65px}.premium-rationale>div{border-top:1px solid var(--line);padding-top:18px}.premium-rationale span{font-size:12px;color:#aab9c8}.premium-rationale h3{font-size:21px;line-height:1.2;margin:10px 0}.premium-rationale p{font-size:15px;line-height:1.55;color:#bac4c8}.vk-premium .vk-products img{aspect-ratio:1;object-fit:cover}.vk-premium .vk-post .vk-art img{aspect-ratio:1;object-fit:contain}.visual-menu a:hover,.widget:hover{opacity:.85}.vk-premium a:focus-visible{outline:3px solid #1d78e0;outline-offset:3px}@media(max-width:850px){.premium-intro{grid-template-columns:1fr;gap:20px}.board-lower{grid-template-columns:1fr}.phone-display{padding:14px}.phone-title strong{font-size:34px}.phone-title small{font-size:13px}.phone-title>span{font-size:12px}.widget-art>strong{font-size:clamp(13px,3vw,24px)}.widget-art>span{font-size:clamp(9px,1.7vw,13px)}}@media(max-width:500px){.portfolio-board{border-radius:15px;padding:10px}.board-caption{font-size:9px;margin-bottom:10px}.community-profile{padding:12px 9px;gap:8px}.community-profile>img{width:49px;height:49px;margin-top:-24px;border-width:2px}.community-profile strong{font-size:16px}.community-profile p{font-size:10px}.community-profile>a{font-size:10px;padding:7px 9px}.board-lower{gap:10px;margin-top:10px}.board-content{gap:10px}.board-panel{padding:10px}.visual-menu,.visual-widgets{gap:6px}.panel-title h2{font-size:15px}.visual-menu strong,.widget>p{font-size:10px}.widget-art>strong{font-size:11px}.widget-art>span{font-size:8px;padding:5px 2px}.premium-rationale{grid-template-columns:1fr;gap:16px;padding-bottom:35px}.premium-intro h1{font-size:clamp(36px,10vw,52px)}.phone{max-width:230px}.phone-title strong{font-size:27px}.phone-title small{font-size:11px}.phone-title>span{font-size:10px}}
.phone.phone-artwork{display:block;aspect-ratio:9/16;box-sizing:content-box;max-width:calc(100% - 14px);width:min(100% - 14px,290px)}.phone-artwork>img{object-fit:contain;object-position:center}.phone-artwork .phone-camera{height:12px;top:8px}@media(max-width:500px){.phone.phone-artwork{width:min(100% - 14px,230px)}}
.vk-showcase.detail{background:#10100f;--panel:#1e1c19;--line:#3c3329}.vk-premium.detailing{--brand:#d99a55;--ink:#f5eee5;--surface:#22201d;--board:#302820}.vk-premium.detailing .portfolio-board{background:radial-gradient(ellipse at 90% 72%,#a0642b33,transparent 55%),var(--board)}.vk-premium.detailing .community-profile p{color:#bdb1a2}.vk-premium.detailing .community-profile>a,.vk-premium.detailing .widget-art>span{color:#20170c}.vk-premium.detailing .widget-art>strong{color:#fff2df}.vk-premium.detailing .phone{box-shadow:12px 22px 35px #0008}
</style>
